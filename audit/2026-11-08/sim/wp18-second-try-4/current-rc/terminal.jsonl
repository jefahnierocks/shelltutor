{"ts": 0.180335, "dir": "out", "enc": "utf8", "data": "\u001b[96mQ3: Why does \u001b[92mvim my notes.txt\u001b[0m open two files instead of one?\u001b[0m\r\n  \u001b[92myour answer:\u001b[0m ", "len": 104}
{"ts": 0.180378, "dir": "in", "enc": "utf8", "data": "because of the space\n", "len": 21}
{"ts": 0.180398, "dir": "out", "enc": "utf8", "data": "because of the space\r\n", "len": 22}
{"ts": 0.186632, "dir": "out", "enc": "utf8", "data": "  \u001b[92m✓\u001b[0m\r\n\r\n", "len": 18}
