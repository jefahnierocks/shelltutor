{"ts": 0.175246, "dir": "out", "enc": "utf8", "data": "> overwrites, >> appends\r\n", "len": 26}
{"ts": 0.18293, "dir": "out", "enc": "utf8", "data": "  \u001b[92m✓\u001b[0m\r\n\r\n", "len": 18}
{"ts": 0.182995, "dir": "out", "enc": "utf8", "data": "\u001b[96mQ3: Why does \u001b[92mvim my notes.txt\u001b[0m open two files instead of one?\u001b[0m\r\n", "len": 80}
{"ts": 0.183033, "dir": "in", "enc": "utf8", "data": "because of the space\n", "len": 21}
