{"ts": 0.215804, "dir": "out", "enc": "utf8", "data": "check\r\n\u001b[?2004l\r", "len": 16}
{"ts": 0.237706, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.23916, "dir": "out", "enc": "utf8", "data": "\u001b[90m--\u001b[0m \u001b[93mshelltutor\u001b[0m \u001b[90m--\u001b[0m \u001b[90mModule : shells\u001b[0m \u001b[90m--------------------------------------------\u001b[0m \u001b[90m--\u001b[0m\r\n", "len": 136}
{"ts": 0.239197, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.239281, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mshells cleared.\u001b[0m\r\n\r\nCommands and keys from this module:\r\n  \u001b[92mecho $BASH_VERSION\u001b[0m \u001b[90mthe shell running now\u001b[0m\r\n", "len": 129}
{"ts": 0.239331, "dir": "out", "enc": "utf8", "data": "  \u001b[92mps -p $$ -o pid,comm\u001b[0m \u001b[90mthis shell, as a running program\u001b[0m\r\n  \u001b[92mcommand -v NAME\u001b[0m \u001b[90mis NAME installed, and where\u001b[0m\r\n  \u001b[92mecho $SHELL   \u001b[0m \u001b[90myour login shell\u001b[0m\r\n\r\n\u001b[93m> Type \u001b[92mquit\u001b[93m to leave, or \u001b[92mnext\u001b[93m to start this module again.\u001b[0m\r\n\r\n", "len": 286}
{"ts": 0.242113, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m \u001b[90m(start this module again)\u001b[0m   \u001b[1;90mquit\u001b[0m \u001b[90m(leave)\u001b[0m   \u001b[1;90mshow\u001b[0m \u001b[90m(this screen again)\u001b[0m\r\n", "len": 134}
{"ts": 0.242355, "dir": "out", "enc": "utf8", "data": "\u001b[90m--------------------------------------------------------------------------------\u001b[0m\r\n\r\n", "len": 93}
