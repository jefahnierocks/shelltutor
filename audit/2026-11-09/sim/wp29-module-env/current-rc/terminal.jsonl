{"ts": 0.320042, "dir": "in", "enc": "utf8", "data": "quit\n", "len": 5}
{"ts": 0.320064, "dir": "out", "enc": "utf8", "data": "quit\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.322519, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.322684, "dir": "out", "enc": "utf8", "data": "Bye. A module saves nothing; run 'shelltutor env' to start it again.\r\n", "len": 70}
