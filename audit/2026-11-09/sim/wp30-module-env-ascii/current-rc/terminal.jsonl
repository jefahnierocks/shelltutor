{"ts": 0.082167, "dir": "out", "enc": "utf8", "data": "SHELL=/bin/zsh\r\nPWD=/var/folders/jx/f_4n055973x5cwnyh_mhlw9h0000gn/T/shelltutor-sim-home-qjz3kxrs/env\r\nLOGNAME=[user]\r\nLINES=24\r\nHOME=/var/folders/jx/f_4n055973x5cwnyh_mhlw9h0000gn/T/shelltutor-sim-userhome-hic6yv0x\r\nCOLUMNS=80\r\nSHELLTUTOR_HOME=/var/folders/jx/f_4n055973x5cwnyh_mhlw9h0000gn/T/shelltutor-sim-home-qjz3kxrs\r\nTMPDIR=/var/folders/jx/f_4n055973x5cwnyh_mhlw9h0000gn/T/\r\nBASH_SILENCE_DEPRECATION_WARNING=1\r\nSHELLTUTOR_ASCII=1\r\n", "len": 438}
