{"ts": 0.23907, "dir": "out", "enc": "utf8", "data": "\u001b[93m| ?\u001b[0m ", "len": 13}
{"ts": 0.248308, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m \u001b[92m[x]\u001b[0m\r\n\r\n", "len": 27}
{"ts": 0.251462, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m 2 of 3   What does \u001b[92mPATH\u001b[0m hold?\r\n", "len": 51}
{"ts": 0.251502, "dir": "in", "enc": "utf8", "data": "a list of folders\n", "len": 18}
