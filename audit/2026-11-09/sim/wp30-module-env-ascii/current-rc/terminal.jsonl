{"ts": 0.266219, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m 3 of 3   You type \u001b[92mPS1='me> '\u001b[0m, then \u001b[92mnext\u001b[0m. What is the prompt on the next\r\n", "len": 102}
{"ts": 0.266262, "dir": "in", "enc": "utf8", "data": "shelltutor>\n", "len": 12}
{"ts": 0.266283, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m          screen?\r\nshelltutor>\r\n", "len": 42}
{"ts": 0.268913, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m          me>    shelltutor>\r\n", "len": 40}
{"ts": 0.268959, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m\r\n\u001b[93m| ?\u001b[0m ", "len": 25}
