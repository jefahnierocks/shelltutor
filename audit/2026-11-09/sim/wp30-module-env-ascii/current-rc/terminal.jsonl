{"ts": 0.304902, "dir": "in", "enc": "utf8", "data": "export TOPIC\n", "len": 13}
{"ts": 0.304925, "dir": "out", "enc": "utf8", "data": "export TOPIC\r\n\u001b[?2004l\r", "len": 23}
{"ts": 0.305005, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
