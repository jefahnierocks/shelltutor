{"ts": 0.167596, "dir": "out", "enc": "utf8", "data": "echo second >> greeting.txt\r\n", "len": 29}
{"ts": 0.167609, "dir": "out", "enc": "utf8", "data": "\u001b[?2004l\r", "len": 9}
{"ts": 0.167701, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.167712, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.167733, "dir": "in", "enc": "utf8", "data": "cat greeting.txt\n", "len": 17}
{"ts": 0.167761, "dir": "out", "enc": "utf8", "data": "cat greeting.txt\r\n", "len": 18}
{"ts": 0.167772, "dir": "out", "enc": "utf8", "data": "\u001b[?2004l\r", "len": 9}
{"ts": 0.169652, "dir": "out", "enc": "utf8", "data": "first\r\nsecond\r\n", "len": 15}
{"ts": 0.169877, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.16989, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.169914, "dir": "in", "enc": "utf8", "data": "next\n", "len": 5}
{"ts": 0.169931, "dir": "out", "enc": "utf8", "data": "next\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.174861, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.176058, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mStage 4 · Commands and streams\u001b[0m \u001b[90m────────────────────────────────\u001b[0m \u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[93m◉\u001b[0m\u001b[90m○\u001b[0m  \u001b[93m4.5\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 255}
{"ts": 0.176102, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.176141, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mPipe, then file\u001b[0m\r\n\r\nA pipe and a \u001b[92m>\u001b[0m work in one line: the last command's output goes to\r\n", "len": 107}
{"ts": 0.176169, "dir": "out", "enc": "utf8", "data": "the file.\r\n\r\n  \u001b[92mls /usr/bin | wc -l > count-of-programs.txt\u001b[0m\r\n  \u001b[92mcat count-of-programs.txt\u001b[0m      \u001b[90m# one number\u001b[0m\r\n\r\nYou'll do this in the task that follows.\r\n\r\n\u001b[93m▶ Try both, then type \u001b[92mnext\u001b[93m.\u001b[0m\r\n\r\n", "len": 232}
