{"ts": 0.099401, "dir": "out", "enc": "utf8", "data": "touch my notes.txt\r\n\u001b[?2004l\r", "len": 29}
{"ts": 0.101422, "dir": "out", "enc": "utf8", "data": "\u001b[?2004hshelltutor> ", "len": 20}
{"ts": 0.101459, "dir": "in", "enc": "utf8", "data": "ls\n", "len": 3}
{"ts": 0.10148, "dir": "out", "enc": "utf8", "data": "ls\r\n\u001b[?2004l\r", "len": 13}
{"ts": 0.103301, "dir": "out", "enc": "utf8", "data": "my\t\tnotes.txt\tpoem.txt\tseed.txt\r\n", "len": 33}
{"ts": 0.103522, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
