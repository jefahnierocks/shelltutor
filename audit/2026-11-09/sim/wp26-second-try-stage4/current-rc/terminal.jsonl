{"ts": 0.107743, "dir": "out", "enc": "utf8", "data": "my\t\tmy notes.txt\tnotes.txt\tpoem.txt\tseed.txt\r\n", "len": 46}
{"ts": 0.107964, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.107977, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.108004, "dir": "in", "enc": "utf8", "data": "next\n", "len": 5}
{"ts": 0.108034, "dir": "out", "enc": "utf8", "data": "next\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.112677, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.11401, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mStage 4 · Commands and streams\u001b[0m \u001b[90m────────────────────────────────\u001b[0m \u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[93m◉\u001b[0m\u001b[90m○\u001b[0m  \u001b[93m4.3\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 255}
{"ts": 0.114044, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.114119, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mThe pipe\u001b[0m\r\n\r\nA pipe, \u001b[92m|\u001b[0m, sends what one command prints into the next command.\r\n", "len": 97}
{"ts": 0.114148, "dir": "out", "enc": "utf8", "data": "\r\n  \u001b[92mseq 1 100 | wc -l\u001b[0m              \u001b[90m# 100: wc counted seq's lines\u001b[0m\r\n  \u001b[92mls /usr/bin | wc -l\u001b[0m            \u001b[90m# how many programs live there\u001b[0m\r\n  \u001b[92mls /usr/bin | sort | head\u001b[0m      \u001b[90m# pipes stack: list, sort, first ten\u001b[0m\r\n\r\nEach piece is an ordinary command. Only the connector is new. \u001b[92m|\u001b[0m is\r\n\u001b[1mShift+Backslash\u001b[0m.\r\n\r\n\u001b[93m▶ Try all three, then type \u001b[92mnext\u001b[93m.\u001b[0m\r\n\r\n", "len": 420}
{"ts": 0.117458, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m   \u001b[1;90mshow\u001b[0m   \u001b[1;90mprev\u001b[0m   \u001b[1;90mquit\u001b[0m\r\n", "len": 71}
{"ts": 0.117778, "dir": "out", "enc": "utf8", "data": "\u001b[90m────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n", "len": 253}
{"ts": 0.131025, "dir": "out", "enc": "utf8", "data": "\u001b[?2004hshelltutor> ", "len": 20}
{"ts": 0.131108, "dir": "in", "enc": "utf8", "data": "seq 1 100 | wc -l\n", "len": 18}
{"ts": 0.13114, "dir": "out", "enc": "utf8", "data": "seq 1 100 | wc -l\r\n\u001b[?2004l\r", "len": 28}
{"ts": 0.133689, "dir": "out", "enc": "utf8", "data": "     100\r\n", "len": 10}
{"ts": 0.133974, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.133988, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.13402, "dir": "in", "enc": "utf8", "data": "ls /usr/bin | wc -l\n", "len": 20}
{"ts": 0.134056, "dir": "out", "enc": "utf8", "data": "ls /usr/bin | wc -l\r\n", "len": 21}
{"ts": 0.134069, "dir": "out", "enc": "utf8", "data": "\u001b[?2004l\r", "len": 9}
{"ts": 0.138791, "dir": "out", "enc": "utf8", "data": "     932\r\n", "len": 10}
{"ts": 0.139104, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.139118, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.139146, "dir": "in", "enc": "utf8", "data": "ls /usr/bin | sort | head\n", "len": 26}
{"ts": 0.139188, "dir": "out", "enc": "utf8", "data": "ls /usr/bin | sort | head\r\n", "len": 27}
{"ts": 0.1392, "dir": "out", "enc": "utf8", "data": "\u001b[?2004l\r", "len": 9}
{"ts": 0.143839, "dir": "out", "enc": "utf8", "data": "AssetCacheLocatorUtil\r\nAssetCacheManagerUtil\r\nAssetCacheTetheratorUtil\r\nDeRez\r\nGetFileInfo\r\nIOAccelMemory\r\n", "len": 107}
{"ts": 0.143868, "dir": "out", "enc": "utf8", "data": "IOMFBDiagnose\r\nIOMFB_FDR_Loader\r\nIOSDebug\r\nResMerger\r\n", "len": 54}
{"ts": 0.144108, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.14412, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.14415, "dir": "in", "enc": "utf8", "data": "next\n", "len": 5}
{"ts": 0.144169, "dir": "out", "enc": "utf8", "data": "next\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.148838, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.150084, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mStage 4 · Commands and streams\u001b[0m \u001b[90m────────────────────────────────\u001b[0m \u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[93m◉\u001b[0m\u001b[90m○\u001b[0m  \u001b[93m4.4\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 255}
{"ts": 0.150116, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.150183, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mInto a file\u001b[0m\r\n\r\n\u001b[92m>\u001b[0m sends what a command prints into a file. \u001b[92m>>\u001b[0m adds to the end.\r\n\r\n", "len": 110}
{"ts": 0.150208, "dir": "out", "enc": "utf8", "data": "  \u001b[92mecho first > greeting.txt\u001b[0m      \u001b[90m# writes over whatever was there\u001b[0m\r\n  \u001b[92mecho second >> greeting.txt\u001b[0m    \u001b[90m# adds a line at the end\u001b[0m\r\n  \u001b[92mcat greeting.txt\u001b[0m               \u001b[90m# two lines\u001b[0m\r\n\r\n\u001b[92m>\u001b[0m replaces the file without asking, whoever typed the line.\r\n\r\n\u001b[93m▶ Try all three, then type \u001b[92mnext\u001b[93m.\u001b[0m\r\n\r\n", "len": 357}
{"ts": 0.153243, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m   \u001b[1;90mshow\u001b[0m   \u001b[1;90mprev\u001b[0m   \u001b[1;90mquit\u001b[0m\r\n", "len": 71}
{"ts": 0.15351, "dir": "out", "enc": "utf8", "data": "\u001b[90m────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n", "len": 253}
