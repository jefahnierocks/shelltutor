{"ts": 0.167321, "dir": "out", "enc": "utf8", "data": "echo first > greeting.txt\r\n\u001b[?2004l\r", "len": 36}
{"ts": 0.167513, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
