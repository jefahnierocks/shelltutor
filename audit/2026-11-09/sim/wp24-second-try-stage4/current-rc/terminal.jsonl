{"ts": 0.198023, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m \u001b[96mQ3: Why does \u001b[92mvim my notes.txt\u001b[0m open two files instead of one?\u001b[0m\r\n", "len": 93}
{"ts": 0.198066, "dir": "in", "enc": "utf8", "data": "because of the space\n", "len": 21}
{"ts": 0.198087, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m \u001b[92manswer in words:\u001b[0m because of the space\r\n", "len": 61}
