{"ts": 0.21766, "dir": "out", "enc": "utf8", "data": "it lists files again\r\n", "len": 22}
{"ts": 0.233224, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m \u001b[91mnot quite.\u001b[0m \u001b[90mhint:\u001b[0m Lesson 2.3: the two dots are the name of one particular other folder.\r\n\u001b[93m┃\u001b[0m Passed stages are saved.\r\n", "len": 158}
{"ts": 0.233315, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m Type \u001b[92mquit\u001b[0m to leave now; the next run starts this stage from its first lesson.\r\n\u001b[93m┃\u001b[0m Type \u001b[92mshow\u001b[0m to see the question again.\r\n\u001b[93m┃ ?\u001b[0m ", "len": 176}
{"ts": 0.233356, "dir": "in", "enc": "utf8", "data": "goes up one folder\n", "len": 19}
{"ts": 0.233379, "dir": "out", "enc": "utf8", "data": "goes up one folder\r\n", "len": 20}
