{"ts": 0.212316, "dir": "out", "enc": "utf8", "data": "\u001b[?2004h", "len": 8}
{"ts": 0.212333, "dir": "out", "enc": "utf8", "data": "shelltutor> ", "len": 12}
{"ts": 0.212365, "dir": "in", "enc": "utf8", "data": "next\n", "len": 5}
{"ts": 0.212387, "dir": "out", "enc": "utf8", "data": "next\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.218694, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.219979, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mStage 4 · Commands and streams\u001b[0m \u001b[90m────────────────────────────────\u001b[0m \u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[90m○\u001b[0m\u001b[93m◉\u001b[0m\u001b[90m○\u001b[0m  \u001b[93m4.5\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 255}
{"ts": 0.220049, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.220067, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mPipe, then file\u001b[0m\r\n\r\nA pipe and a \u001b[92m>\u001b[0m work in one line: the last command's output goes to\r\nthe file.\r\n\r\n  \u001b[92mls /usr/bin | wc -l > count-of-programs.txt\u001b[0m\r\n  \u001b[92mcat count-of-programs.txt\u001b[0m      \u001b[90m# one number\u001b[0m\r\n\r\nYou'll do this in the task that follows.\r\n", "len": 285}
{"ts": 0.220112, "dir": "out", "enc": "utf8", "data": "\r\n\u001b[93m▶ Try both, then type \u001b[92mnext\u001b[93m.\u001b[0m\r\n\r\n", "len": 54}
