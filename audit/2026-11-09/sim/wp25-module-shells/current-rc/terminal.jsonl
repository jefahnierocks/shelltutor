{"ts": 0.085401, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mModule · shells\u001b[0m \u001b[90m───────────────────────────────────────────────────\u001b[0m \u001b[93m2 of 3\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 238}
