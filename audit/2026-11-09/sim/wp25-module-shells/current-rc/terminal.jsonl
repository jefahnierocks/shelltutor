{"ts": 0.161797, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m \u001b[92m[✓]\u001b[0m\r\n\r\n", "len": 31}
{"ts": 0.165361, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m 2 of 3   What do you type to ask whether zsh is installed?\r\n", "len": 73}
{"ts": 0.165406, "dir": "in", "enc": "utf8", "data": "command -v zsh\n", "len": 15}
{"ts": 0.16543, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m\r\n\u001b[93m┃ ?\u001b[0m command -v zsh\r\n", "len": 45}
{"ts": 0.17497, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m \u001b[92m[✓]\u001b[0m\r\n\r\n", "len": 31}
{"ts": 0.178077, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m 3 of 3   \u001b[92mecho $SHELL\u001b[0m prints which shell?\r\n", "len": 64}
