{"ts": 0.20597, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mModule · shells\u001b[0m \u001b[90m─────────────────────────────────────────────────────\u001b[0m \u001b[93mtask\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 242}
