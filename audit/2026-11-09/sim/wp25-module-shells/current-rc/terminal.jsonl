{"ts": 0.250208, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mshells cleared.\u001b[0m\r\n\r\nCommands and keys from this module:\r\n  \u001b[92mecho $BASH_VERSION\u001b[0m \u001b[90mthe shell running now\u001b[0m\r\n  \u001b[92mps            \u001b[0m \u001b[90mthe shell is one of the running programs\u001b[0m\r\n  \u001b[92mcommand -v NAME\u001b[0m \u001b[90mis NAME installed, and where\u001b[0m\r\n  \u001b[92mecho $SHELL   \u001b[0m \u001b[90myour login shell\u001b[0m\r\n\r\n", "len": 327}
{"ts": 0.250313, "dir": "out", "enc": "utf8", "data": "\u001b[93m▶ Type \u001b[92mquit\u001b[93m to leave, or \u001b[92mnext\u001b[93m to start this module again.\u001b[0m\r\n\r\n", "len": 92}
