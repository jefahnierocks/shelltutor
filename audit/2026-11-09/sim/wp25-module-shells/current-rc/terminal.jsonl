{"ts": 0.148617, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m 1 of 3   The shell runs the programs you name. What kind of thing is the\r\n", "len": 87}
{"ts": 0.148659, "dir": "in", "enc": "utf8", "data": "a program\n", "len": 10}
{"ts": 0.148683, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m          shell itself?\r\na program\r\n", "len": 48}
{"ts": 0.151466, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m          a program    a file    a folder    a window\r\n", "len": 67}
{"ts": 0.15149, "dir": "out", "enc": "utf8", "data": "\u001b[93m┃\u001b[0m\r\n", "len": 14}
