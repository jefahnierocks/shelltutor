{"ts": 0.140277, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mModule · env\u001b[0m \u001b[90m──────────────────────────────────────────────────────\u001b[0m \u001b[93m4 of 5\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 244}
