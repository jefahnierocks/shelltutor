{"ts": 0.062379, "dir": "in", "enc": "utf8", "data": "next\n", "len": 5}
{"ts": 0.062418, "dir": "out", "enc": "utf8", "data": "next\r\n\u001b[?2004l\r", "len": 15}
{"ts": 0.068518, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.069887, "dir": "out", "enc": "utf8", "data": "\u001b[90m--\u001b[0m \u001b[90mModule\u001b[0m \u001b[90m----------------------------------------------------------\u001b[0m \u001b[93menv  1/6\u001b[0m \u001b[90m--\u001b[0m\r\n", "len": 127}
{"ts": 0.069946, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.069994, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mVariables\u001b[0m\r\n\r\nA \u001b[1mvariable\u001b[0m is a name that holds a value. The shell swaps \u001b[92m$name\u001b[0m for\r\n", "len": 109}
{"ts": 0.070013, "dir": "out", "enc": "utf8", "data": "the value before it runs the line.\r\n\r\n  \u001b[92mecho $HOME\u001b[0m        \u001b[90m# one the shell already has\u001b[0m\r\n  \u001b[92mpet=owl\u001b[0m           \u001b[90m# set your own: no spaces around =\u001b[0m\r\n  \u001b[92mecho $pet\u001b[0m         \u001b[90m# prints owl\u001b[0m\r\n  \u001b[92menv | head\u001b[0m        \u001b[90m# some of the variables programs receive\u001b[0m\r\n\r\n\u001b[92mpet\u001b[0m is not in that list yet. The next lesson shows why.\r\n\r\n\u001b[93m> Try all four, then type \u001b[92mnext\u001b[93m.\u001b[0m\r\n\r\n", "len": 435}
{"ts": 0.073592, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m \u001b[90m(go on)\u001b[0m   \u001b[1;90mshow\u001b[0m \u001b[90m(this screen again)\u001b[0m   \u001b[1;90mprev\u001b[0m \u001b[90m(back)\u001b[0m   \u001b[1;90mquit\u001b[0m \u001b[90m(save and leave)\u001b[0m\r\n", "len": 159}
{"ts": 0.073818, "dir": "out", "enc": "utf8", "data": "\u001b[90m--------------------------------------------------------------------------------\u001b[0m\r\n", "len": 91}
