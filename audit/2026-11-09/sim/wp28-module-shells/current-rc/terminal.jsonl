{"ts": 0.116602, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mModule\u001b[0m \u001b[90m───────────────────────────────────────────────────────\u001b[0m \u001b[93mshells  3/3\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 245}
