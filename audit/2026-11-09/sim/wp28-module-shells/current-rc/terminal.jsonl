{"ts": 0.142144, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[90mModule\u001b[0m \u001b[90m──────────────────────────────────────────────────────\u001b[0m \u001b[93mshells  gate\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 243}
