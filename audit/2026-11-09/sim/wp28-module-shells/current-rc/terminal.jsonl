{"ts": 0.252274, "dir": "out", "enc": "utf8", "data": "\u001b[90m──\u001b[0m \u001b[93mshelltutor\u001b[0m \u001b[90m──\u001b[0m \u001b[90mModule · shells\u001b[0m \u001b[90m────────────────────────────────────────────\u001b[0m \u001b[90m──\u001b[0m\r\n", "len": 237}
{"ts": 0.252315, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.252382, "dir": "out", "enc": "utf8", "data": "\u001b[1;97mshells cleared.\u001b[0m\r\n\r\nCommands and keys from this module:\r\n", "len": 67}
{"ts": 0.252422, "dir": "out", "enc": "utf8", "data": "  \u001b[92mecho $BASH_VERSION\u001b[0m \u001b[90mthe shell running now\u001b[0m\r\n  \u001b[92mps -o pid,comm\u001b[0m \u001b[90mthe programs on this terminal\u001b[0m\r\n  \u001b[92mcommand -v NAME\u001b[0m \u001b[90mis NAME installed, and where\u001b[0m\r\n  \u001b[92mecho $SHELL   \u001b[0m \u001b[90myour login shell\u001b[0m\r\n\r\n\u001b[93m▶ Type \u001b[92mquit\u001b[93m to leave, or \u001b[92mnext\u001b[93m to start this module again.\u001b[0m\r\n\r\n", "len": 341}
{"ts": 0.255186, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m \u001b[90m(start this module again)\u001b[0m   \u001b[1;90mquit\u001b[0m \u001b[90m(leave)\u001b[0m   \u001b[1;90mshow\u001b[0m \u001b[90m(this screen again)\u001b[0m\r\n", "len": 134}
