{"ts": 0.181927, "dir": "out", "enc": "utf8", "data": "\u001b[3J\u001b[H\u001b[2J", "len": 11}
{"ts": 0.183284, "dir": "out", "enc": "utf8", "data": "\u001b[90m--\u001b[0m \u001b[90mModule\u001b[0m \u001b[90m---------------------------------------------------------\u001b[0m \u001b[93menv  gate\u001b[0m \u001b[90m--\u001b[0m\r\n", "len": 127}
{"ts": 0.183311, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.183343, "dir": "out", "enc": "utf8", "data": "\u001b[1;97menv — gate\u001b[0m\r\n\r\n\u001b[36mRecall\u001b[0m (three questions, all three must be correct).\r\n", "len": 90}
{"ts": 0.183389, "dir": "out", "enc": "utf8", "data": "First, three questions. Type your answer in words; this is not the shell.\r\n\r\nThen a \u001b[36mpractical task\u001b[0m.\r\n\r\n", "len": 112}
{"ts": 0.185283, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mshow\u001b[0m \u001b[90m(the question again)\u001b[0m   \u001b[1;90mquit\u001b[0m \u001b[90m(save and leave)\u001b[0m\r\n", "len": 91}
{"ts": 0.185516, "dir": "out", "enc": "utf8", "data": "\u001b[90m--------------------------------------------------------------------------------\u001b[0m\r\n", "len": 91}
{"ts": 0.185534, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.189382, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m 1 of 3   Which command makes a variable visible to the programs the shell\r\n", "len": 86}
