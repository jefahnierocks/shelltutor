{"ts": 0.189474, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m          starts?\r\nexport\r\n", "len": 37}
{"ts": 0.193154, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m          set    export    env    echo\r\n", "len": 50}
{"ts": 0.193205, "dir": "out", "enc": "utf8", "data": "\u001b[93m|\u001b[0m\r\n\u001b[93m| ?\u001b[0m ", "len": 25}
