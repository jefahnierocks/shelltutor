{"ts": 0.296093, "dir": "out", "enc": "utf8", "data": "\u001b[90m--\u001b[0m \u001b[93mshelltutor\u001b[0m \u001b[90m--\u001b[0m \u001b[90mModule : env\u001b[0m \u001b[90m-----------------------------------------------\u001b[0m \u001b[90m--\u001b[0m\r\n", "len": 136}
{"ts": 0.296151, "dir": "out", "enc": "utf8", "data": "\r\n", "len": 2}
{"ts": 0.29622, "dir": "out", "enc": "utf8", "data": "\u001b[1;97menv cleared.\u001b[0m\r\n\r\nCommands and keys from this module:\r\n  \u001b[92mname=value    \u001b[0m \u001b[90mset a variable in this shell\u001b[0m\r\n", "len": 129}
{"ts": 0.296271, "dir": "out", "enc": "utf8", "data": "  \u001b[92mexport name   \u001b[0m \u001b[90mlet child programs see it\u001b[0m\r\n  \u001b[92mecho \"$PATH\"  \u001b[0m \u001b[90mthe folders searched for programs\u001b[0m\r\n  \u001b[92menv           \u001b[0m \u001b[90mlist what children receive\u001b[0m\r\n  \u001b[92mPS1='$ '      \u001b[0m \u001b[90mchange the prompt (this shell only)\u001b[0m\r\n  \u001b[92mSHELLTUTOR_HOME\u001b[0m \u001b[90mwhere this tutor puts your practice folder\u001b[0m\r\n\r\n\u001b[93m> Type \u001b[92mquit\u001b[93m to leave, or \u001b[92mnext\u001b[93m to return to the start of this module.\u001b[0m\r\n\r\n", "len": 450}
{"ts": 0.298802, "dir": "out", "enc": "utf8", "data": "\u001b[1;90mnext\u001b[0m \u001b[90m(start this module again)\u001b[0m   \u001b[1;90mquit\u001b[0m \u001b[90m(leave)\u001b[0m   \u001b[1;90mshow\u001b[0m \u001b[90m(this screen again)\u001b[0m\r\n", "len": 134}
{"ts": 0.299039, "dir": "out", "enc": "utf8", "data": "\u001b[90m--------------------------------------------------------------------------------\u001b[0m\r\n\r\n", "len": 93}
