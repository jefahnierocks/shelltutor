        'the full path' \
        'the full path to vim' \
        'the folder and file name' \
        -- \
        'the path|a path|its path|vims path|path to|full path|the location|its location|location of|where vim is|where the program is|where the vim program is|where the program file is|/usr/bin/vim|the folder and name of the program file|folder and file name' || return $?

    ask_question \
        "Q2: What is the difference between ${CMD}>${RST} and ${CMD}>>${RST}?" \
        "Lesson 4.3: what each arrow does to a file that already exists." \
        '> overwrites, >> appends' \
        '> overwrite, >> append' \
        '> writes over, >> adds to the end' \
        '>> appends' \
        '> overwrites' \
        'one overwrites one appends' \
        '> replaces >> appends' \
        -- \
        --ordered \
        'overwrite|overwrites|replace|replaces|writes over|wipes|clobber|clobbers|starts fresh|erases|truncates' \
        'append|appends|adds|add to|the end|to the end' || return $?

    ask_question \
        "Q3: Why does ${CMD}vim my notes.txt${RST} open two files instead of one?" \
        "Lesson 4.1: how the shell cuts a line into words, and what quotes do." \
        'because of the space' \
        'spaces split arguments' \
        'spaces split words' \
        'the space splits them' \
        'no quotes' \
        'missing quotes' \
        'because spaces' \
        'because of spaces' \
        'the shell splits on spaces' \
        -- \
        'space|spaces|split|splits|two words|separate|separates' \
        --reject \
        'screen|missing|window|terminal' || return $?

    # Clean slate once at gate entry; setup_stage_dir seeds seed.txt so the
