finale() {
    clear 2>/dev/null || printf '\n'
    cat <<EOF
${H1}You're ready for vimtutor.${RST}

Across five stages you have met:

  ${SUB}commands${RST}    echo, pwd, whoami, date, clear, exit,
                ls, cd, ~, .., touch, mkdir, rmdir,
                cat, less, cp, mv, rm,
                command -v, wc, seq, head, sort, grep,
                man, vim, vim --version, vimtutor
  ${SUB}keys${RST}        Tab, Up Arrow, Ctrl+C, Ctrl+L, q, Esc
  ${SUB}operators${RST}   ${CMD}|${RST} (pipe)  ${CMD}>${RST} (redirect)  ${CMD}>>${RST} (append)
                ${CMD}<${RST} (input)  ${CMD}*${RST} (glob)
  ${SUB}ideas${RST}       prompt vs program  ·  buffer vs file
                relative vs absolute paths
                file is not changed until the buffer is written

${SUB}What's next${RST}:

  ${CMD}vimtutor${RST}
    ${DIM}# the Vim tutor itself; about 30 minutes, hands-on${RST}

If ${CMD}vimtutor${RST} isn't installed:
  - Linux: install your distro's full vim package
    (Fedora: ${CMD}sudo dnf install vim-enhanced${RST}; Debian/Ubuntu: ${CMD}sudo apt install vim${RST})
  - macOS:  ${CMD}brew install vim${RST}

Re-take any stage at any time:
  ${CMD}shelltutor 1${RST}   ${DIM}# replay Stage 1${RST}

Sandbox stays at ${DIR}${SANDBOX}${RST} if you want to keep playing.

EOF
    # Clean up progress so the next plain `shelltutor` invocation starts from
    # Stage 1 unless `shelltutor N` is given.
    rm -f "$PROGRESS_FILE" 2>/dev/null || true
}

# ---------------------------------------------------------------------
# Stage-cleared screens (A1.4, A3.5)
#
# A stopping point after each of stages 1-4. The screen is a panel with no
# current stage in the header (the dots show what is passed) and the
# `cleared` footer. Stage 5 keeps its own line and flows into the finale.
# ---------------------------------------------------------------------

# recap_line LABEL GLOSS [ROLE]: "  label   gloss", label in ROLE (default CMD).
recap_line() {
    printf '  %s%-14s%s %s%s%s\n' "${3:-$CMD}" "$1" "$RST" "$DIM" "$2" "$RST"
}

# stage_recap N: at most eight lines, commands then keys or operators.
stage_recap() {
    case "$1" in
        1)
            recap_line echo 'print the words you give it'
            recap_line pwd 'show where you are'
            recap_line whoami 'show who you are'
            recap_line date 'show the date and time'
            recap_line clear 'empty the screen (Ctrl+L too)'
            recap_line Tab 'finish a name for you' "$KEY"
            recap_line Up 'bring back an earlier command' "$KEY"
            recap_line Ctrl+C 'stop a running command' "$KEY"
            ;;
        2)
            recap_line ls 'list what is here'
            recap_line 'ls -l' 'list with details'
            recap_line 'ls -a' 'include hidden names'
            recap_line cd 'change folder'
            recap_line 'cd ..' 'go up one folder'
            recap_line 'cd ~' 'go to your home folder'
            recap_line 'cd -' 'go back to the last folder'
            recap_line pwd 'show where you are'
            ;;
        3)
            recap_line touch 'make an empty file'
            recap_line mkdir 'make a folder'
            recap_line rmdir 'remove an empty folder'
            recap_line cat 'print a file'
            recap_line less 'page through a file (q leaves)'
            recap_line cp 'copy a file'
            recap_line mv 'move or rename a file'
            recap_line rm 'delete a file (no undo)'
            ;;
        4)
            recap_line 'command -v' 'is this program installed?'
            recap_line wc 'count lines and words'
            recap_line seq 'count out numbers'
            recap_line head 'show the first lines only'
            recap_line sort 'put lines in order'
            recap_line grep 'keep the lines that match'
            recap_line '|' 'feed one output into the next command'
            recap_line '>  >>  <  *' 'to a file, add, from a file, match many'
            ;;
    esac
}

# stage_cleared N: show the screen for the stage just passed. Returns the
# practice() code (RC_NEXT, RC_SHOW, RC_PREV, RC_CHECK).
stage_cleared() {
    local n=$1 next=$(( $1 + 1 )) next_title
    panel_title "$next"
    next_title="$REPLY"
    PANEL_STAGE=''; PANEL_POS=''; PANEL_DONE=$n
    show_screen <<RECAP
${H1}${G_OK} Stage ${n} cleared.${RST}

You can now:
$(stage_recap "$n")

${DIM}Next: Stage ${next} ${G_SEP} ${next_title}${RST}

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} for Stage ${next}, or ${CMD}quit${INSTR} to stop here. Your place is saved.${RST}
RECAP
    practice "$SANDBOX" cleared
    return $?
}

# ---------------------------------------------------------------------
# Stage dispatcher
# ---------------------------------------------------------------------

run_stage() {
    case "$1" in
        1) run_stage1 ;;
        2) run_stage2 ;;
        3) run_stage3 ;;
        4) run_stage4 ;;
        5) run_stage5 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------
# main
# ---------------------------------------------------------------------

main() {
    local start
    case "${1:-}" in
        -h|--help) usage; exit 0 ;;
        --info|-i) show_info; exit 0 ;;
        '')
            start=$(($(read_progress) + 1))
            if [ "$start" -gt "$TOTAL_STAGES" ]; then
                # Everything passed — show finale and exit.
                preflight || exit 1
                setup_sandbox
                finale
                exit 0
            fi
            ;;
        [1-5])
            start=$1
            ;;
        *)
            echo "shelltutor: argument must be a stage number (1..5)." >&2
            usage >&2
            exit 1
            ;;
    esac

    # Catch the most common "this won't work on your system" problems
    # with a one-sentence diagnostic before any lesson screen renders.
    preflight || exit 1

    setup_sandbox

    local s rc
    for ((s=start; s<=TOTAL_STAGES; s++)); do
        run_stage "$s"
        rc=$?
        if [ "$rc" -ne 0 ]; then
            # quit / interrupt — bail without finale; progress file already saved.
            exit 0
        fi
        if [ "$s" -lt "$TOTAL_STAGES" ]; then
            while true; do
                stage_cleared "$s"
                rc=$?
                case "$rc" in
                    "$RC_NEXT") break ;;
                    "$RC_SHOW"|"$RC_PREV") : ;;
                    "$RC_CHECK")
                        printf '\n%b(check is only for gate tasks. Type next to continue.)%b\n' "$DIM" "$RST"
                        sleep 2
                        ;;
                    *) exit 0 ;;
                esac
            done
        fi
    done

    finale
}

main "$@"
