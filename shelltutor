stage4_gate() {
    show_screen recall <<EOF
${H1}STAGE 4 — GATE${RST}

${BOLD}Recall${RST} (three questions, all three must be correct).
First, three questions. Type your answer in words; this is not the shell.

Then a ${BOLD}practical task${RST}.
EOF

    ask_question \
        "Q1: What does ${CMD}command -v vim${RST} print, if Vim is installed?" \
        "Lesson 4.1: command -v asks the shell about a command and answers in one line." \
        'the path to vim' \
        'path to vim' \
        'a path' \
        'the path' \
        'where vim is' \
        "vim's path" \
        'vims path' \
        '/usr/bin/vim' \
        'the path /usr/bin/vim' \
        'the path to the vim program' \
        'where the vim program is' \
        'where the program file is' \
        'the location of vim' \
        "vim's location" \
        'its location' \
        'the full path' \
        'the full path to vim' \
        'the folder and file name' \
        -- \
        'the path|a path|its path|vims path|path to|full path|the location|its location|location of|where vim is|where the program is|where the vim program is|where the program file is|/usr/bin/vim|the folder and name of the program file|folder and file name' || return $?

    ask_question \
        "Q2: What is the difference between ${CMD}>${RST} and ${CMD}>>${RST}?" \
        "Lesson 4.4: what each arrow does to a file that already exists." \
        '> overwrites, >> appends' \
        '> overwrite, >> append' \
        '> writes over, >> adds to the end' \
        '>> appends' \
        '> overwrites' \
        'one overwrites one appends' \
        '> replaces >> appends' \
        -- \
        --ordered \
        'overwrite|overwrites|replace|replaces|writes over|wipes|clobber|clobbers|starts fresh|erases|truncates' \
        'append|appends|adds|add to|the end|to the end' || return $?

    ask_question \
        "Q3: Why does ${CMD}vim my notes.txt${RST} open two files instead of one?" \
        "Lesson 4.2: how the shell cuts a line into words, and what quotes do." \
        'because of the space' \
        'spaces split arguments' \
        'spaces split words' \
        'the space splits them' \
        'no quotes' \
        'missing quotes' \
        'because spaces' \
        'because of spaces' \
        'the shell splits on spaces' \
        -- \
        'space|spaces|split|splits|two words|separate|separates' \
