# ---------------------------------------------------------------------
# Stage-cleared screens (A1.4, A3.5)
#
# A stopping point after each of stages 1-4. The screen is a panel with no
# current stage in the header (the dots show what is passed) and the
# `cleared` footer. Stage 5 keeps its own line and flows into the finale.
# ---------------------------------------------------------------------

# recap_line LABEL GLOSS [ROLE]: "  label   gloss", label in ROLE (default CMD).
# Modules only until WP-26; the stage recaps use can_line.
recap_line() {
    printf '  %s%-14s%s %s%s%s\n' "${3:-$CMD}" "$1" "$RST" "$DIM" "$2" "$RST"
}

# can_line CAPABILITY CMD...: "  capability   cmd   cmd" (A11 C9): what the
# learner can do first, the commands second, in two columns.
can_line() {
    local cap="$1" c i=0; shift
    printf '  %-28s' "$cap"
    for c in "$@"; do
        i=$((i + 1))
        if [ "$i" -lt "$#" ]; then
            printf ' %s%-9s%s' "$CMD" "$c" "$RST"
        else
            printf ' %s%s%s' "$CMD" "$c" "$RST"
        fi
    done
    printf '\n'
}

# stage_recap N: at most six lines (the cleared panel stays at 19 rows),
# capability first.
stage_recap() {
    case "$1" in
        1)
            can_line 'say something back' echo
            can_line 'find where you are' pwd
            can_line 'find out who you are, when' whoami date
            can_line 'finish a name, reuse a line' Tab Up
            can_line 'stop a running command' Ctrl+C
            ;;
        2)
            can_line 'find where you are' pwd
            can_line 'see what is here' ls 'ls -p' 'ls -a'
            can_line 'move' cd 'cd ..' 'cd -'
            can_line 'make a folder' mkdir
            ;;
        3)
            can_line 'make an empty file' touch
            can_line 'make a folder' mkdir
            can_line 'read a file' cat less
            can_line 'copy, move or rename' cp mv
            can_line 'delete a file (no undo)' rm
            ;;
        4)
            can_line 'ask if a program is there' 'command -v'
            can_line 'count lines, count out numbers' wc seq
            can_line 'order lines, take the first' sort head
            can_line 'chain commands' '|'
            can_line 'send output to a file' '>' '>>'
            can_line 'match many names' '*'
            ;;
    esac
}

# stage_cleared N: show the screen for the stage just passed. Returns the
# practice() code (RC_NEXT, RC_SHOW, RC_PREV, RC_CHECK).
stage_cleared() {
    local n=$1 next=$(( $1 + 1 )) next_title
    panel_title "$next"
    next_title="$REPLY"
    PANEL_STAGE=''; PANEL_POS=''; PANEL_DONE=$n
    show_screen cleared <<RECAP
${H1}Stage ${n} cleared${RST}

You can now

$(stage_recap "$n")

Next: Stage ${next} ${G_DOT_SEP} ${next_title}

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to go on, or ${CMD}quit${INSTR} to stop here. Your place is saved.${RST}
RECAP
    practice "$SANDBOX"
    return $?
}

