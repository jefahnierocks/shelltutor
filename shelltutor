To put words in a file, send ${CMD}echo${RST}'s output into it (more on ${CMD}>${RST} in Stage 4):
  ${CMD}echo hello > notes.txt${RST}   ${DIM}# put words in a file${RST}

So: ${CMD}touch${RST} for empty files, ${CMD}mkdir${RST} for folders, ${CMD}>${RST} for words.

${INSTR}${G_PLAY} Make a few, put a word in one, then ${CMD}next${INSTR}.${RST}
EOF
}

stage3_lesson_2() {
    lesson "$SANDBOX/stage3" <<EOF
${H1}Reading: cat, less${RST}

${CMD}cat${RST} prints the entire file at once.
  ${CMD}cat hello.txt${RST}                ${DIM}# probably empty${RST}
  ${CMD}cat ../poem.txt${RST}        ${DIM}# the tutor's poem, one folder up${RST}

For a long file, ${CMD}cat${RST} floods the screen. Use ${CMD}less${RST}
to page through it:
  ${CMD}less ../numbers.txt${RST}    ${DIM}# 50 lines — more than one screen${RST}

Inside ${CMD}less${RST}, the screen takes over. Press ${BOLD}Space${RST}
or ${BOLD}f${RST} to page down, ${BOLD}b${RST} to page back, and
${BOLD}q${RST} to exit. (More on full-screen programs in Stage 5.)

${EM}Important:${RST} when ${CMD}less${RST} takes over, the prompt is
gone. You're inside a program. ${BOLD}q${RST} returns you to the shell.

${INSTR}${G_PLAY} Try both; ${BOLD}q${INSTR} leaves ${CMD}less${INSTR}; then ${CMD}next${INSTR}.${RST}
EOF
}

stage3_lesson_3() {
    lesson "$SANDBOX/stage3" <<EOF
${H1}Copy, move, delete${RST}

${CMD}cp${RST} copies. The original stays.
  ${CMD}cp hello.txt backup.txt${RST}

${CMD}mv${RST} moves; the same command ${BOLD}renames${RST}:
  ${CMD}mv hello.txt hi.txt${RST}            ${DIM}# rename${RST}
  ${CMD}mv hi.txt notes/${RST}               ${DIM}# move into a folder${RST}

${CMD}rm${RST} deletes. ${EM}Immediately and permanently.${RST}
  ${CMD}rm backup.txt${RST}

There is no Trash and no undo. ${EM}Look before you press Enter —
you, or an assistant typing for you.${RST}

${BOLD}A safety habit${RST}: ${CMD}ls${RST} first, then ${CMD}rm <only-now-that-you-are-sure>${RST}.

${INSTR}${G_PLAY} Try ${CMD}cp${INSTR}, ${CMD}mv${INSTR} and ${CMD}rm${INSTR} on the practice files, then ${CMD}next${INSTR}.${RST}
EOF
}

stage3_verify_task() {
    [ -f "$SANDBOX/stage3/done.txt" ] || return 1
    [ ! -f "$SANDBOX/stage3/notes.txt" ] || return 1
    [ ! -f "$SANDBOX/stage3/backup.txt" ] || return 1
    grep -q 'hello' "$SANDBOX/stage3/done.txt" || return 1
    return 0
}

stage3_gate() {
    show_screen recall <<EOF
${H1}STAGE 3 — GATE${RST}

${BOLD}Recall${RST} (three questions, all three must be correct).
Then a ${BOLD}practical task${RST}.
EOF

    ask_question \
        "Q1: Which command creates an empty file?  (touch, mkdir, new, cat)" \
        "Lesson 3.1: the file command that can also update a timestamp." \
        'touch' \
        -- \
        'touch' \
        --reject \
        'wrong|incorrect|mkdir|cat' || return $?

    ask_question \
        "Q2: After ${CMD}rm important.txt${RST}, where is the file?  (~/.Trash, on disk, gone, depends)" \
        "Lesson 3.3: what rm does, and whether it can be undone." \
        'gone' \
        "it's gone" \
        'its gone' \
        -- \
        'gone|deleted|removed|for good|permanently' \
        --reject \
        'trash|browser|recycle|bin' || return $?

    ask_question \
        "Q3: What single command renames old.txt${RST} to new.txt${RST}?" \
        "Lesson 3.3: the same command that moves a file renames it." \
        'mv' \
        'mv old.txt new.txt' \
        'mv old new' \
        -- \
        'mv' \
        --reject \
        'wrong|incorrect|cp|cat|rm' || return $?

    # Clean slate once at gate entry. Learner state then persists across
    # in-gate `show` redisplays so a partial task can be completed.
    setup_stage_dir 3
    rm -f "$SANDBOX/stage3/notes.txt" "$SANDBOX/stage3/backup.txt" "$SANDBOX/stage3/done.txt" 2>/dev/null

    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}STAGE 3 — GATE TASK${RST}

You will work inside ${SANDBOX}/stage3${RST}.

Do these, in order:

  1. create a file notes.txt${RST} containing the word ${BOLD}hello${RST}
  2. copy notes.txt${RST} to backup.txt${RST}
  3. rename notes.txt${RST} to done.txt${RST}
  4. remove backup.txt${RST}

Then type ${CMD}check${RST}. The script will look at the folder.

${DIM}I will check: done.txt exists with 'hello' in it; notes.txt and${RST}
${DIM}backup.txt are gone.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} when done.${RST}
EOF
        fi
        skip_screen=0
        practice "$SANDBOX/stage3"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if stage3_verify_task; then
                    save_progress 3
                    return 0
                fi
                attempt=$((attempt + 1))
                fb_begin
                if [ ! -f "$SANDBOX/stage3/done.txt" ]; then
                    fb_todo "done.txt has hello" "no done.txt in this folder"
                elif grep -q 'hello' "$SANDBOX/stage3/done.txt"; then
                    fb_ok "done.txt has hello"
                else
                    fb_todo "done.txt has hello" "done.txt has no hello in it"
                fi
                if [ -f "$SANDBOX/stage3/notes.txt" ]; then
                    fb_todo "notes.txt gone" "notes.txt is still here"
                else
                    fb_ok "notes.txt gone"
                fi
                if [ -f "$SANDBOX/stage3/backup.txt" ]; then
                    fb_todo "backup.txt gone" "backup.txt is still here"
                else
                    fb_ok "backup.txt gone"
                fi
                fb_close
                gate_escalate "$attempt" \
                    "echo hello > notes.txt writes a file; cp copies; mv renames; rm removes." \
                    "echo hello > notes.txt" "cp notes.txt backup.txt" \
                    "mv notes.txt done.txt" "rm backup.txt"
                skip_screen=1
                ;;
            "$RC_QUIT") return $rc ;;
            *) : ;;
        esac
    done
}

run_stage3() {
    setup_stage_dir 3
    local lessons=(stage3_intro stage3_lesson_1 stage3_lesson_2 stage3_lesson_3)
    local i=0
    while [ "$i" -lt "${#lessons[@]}" ]; do
        panel_at 3 "${lessons[$i]}"
        "${lessons[$i]}"
        local rc=$?
        case "$rc" in
            "$RC_NEXT")  ((i++)) ;;
            "$RC_SHOW")  : ;;
            "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
            "$RC_CHECK")
                # `check` only verifies a gate task; at a lesson it is
                # a no-op. Print a one-line note, pause briefly so the
                # learner can read it, then re-display the lesson via
                # the loop's default (i unchanged).
                printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                sleep 2
                ;;
            *)         return "$rc" ;;
        esac
    done
    PANEL_STAGE=3; PANEL_POS=task
    stage3_gate
}

