}

module_env_lesson_2() {
    lesson "$SANDBOX/env" <<EOF
${H1}env 2 — export and child programs${RST}

A program the shell starts is a ${SUB}child${RST}. It receives only the
variables that were ${SUB}exported${RST}. Single quotes stop this shell from
replacing ${CMD}\$pet${RST}, so the child does it.

  ${CMD}pet=owl${RST}                          ${DIM}# set it again: new screen, new shell${RST}
  ${CMD}bash -c 'echo [\$pet]'${RST}            ${DIM}# prints [] : the child sees nothing${RST}
  ${CMD}export pet${RST}                       ${DIM}# mark it for children${RST}
  ${CMD}bash -c 'echo [\$pet]'${RST}            ${DIM}# prints [owl]${RST}
  ${CMD}env | grep '^pet='${RST}               ${DIM}# now it is listed${RST}

Notice that ${CMD}export${RST} copies nothing. It marks the name so every
child gets the value at the moment it starts.

${INSTR}${G_PLAY} Run the five lines in order, then type ${CMD}next${INSTR}.${RST}
EOF
}

module_env_lesson_3() {
    lesson "$SANDBOX/env" <<EOF
${H1}env 3 — PATH is a list${RST}

${CMD}PATH${RST} is a variable that holds folders separated by ${CMD}:${RST}. When you
type a command name, the shell looks in those folders, in order, and
runs the first match.

  ${CMD}echo "\$PATH"${RST}                  ${DIM}# one long line${RST}
  ${CMD}echo "\$PATH" | tr : '\n'${RST}      ${DIM}# one folder per line${RST}
  ${CMD}command -v ls${RST}                 ${DIM}# the folder where ls was found${RST}

This is why ${CMD}command -v${RST} (Stage 4) could answer: it reads this list.
A program in a folder that is not on the list is not found by name.

${INSTR}${G_PLAY} Run the three lines, then type ${CMD}next${INSTR}.${RST}
EOF
}

module_env_lesson_4() {
    lesson "$SANDBOX/env" <<EOF
${H1}env 4 — the prompt is a variable${RST}

The text before your cursor is the variable ${CMD}PS1${RST}. Change it and the
prompt changes at once.

  ${CMD}PS1='me> '${RST}       ${DIM}# the prompt is now me>${RST}
  ${CMD}PS1='\$ '${RST}         ${DIM}# and now a plain dollar sign${RST}

Try both. Then type ${CMD}next${RST} and look at the prompt on the next screen.

${INSTR}${G_PLAY} Change the prompt, then type ${CMD}next${INSTR}.${RST}
EOF
}

module_env_lesson_5() {
    lesson "$SANDBOX/env" <<EOF
${H1}env 5 — where this lives for real${RST}

Your prompt went back: each screen starts a fresh shell, and the tutor
ignores your own configuration files so every learner sees the same thing.
A real terminal reads one file when it starts:
  ${DIR}~/.bashrc${RST}   if your login shell is bash
  ${DIR}~/.zshrc${RST}    if it is zsh ${DIM}(check: echo \$SHELL)${RST}
${DIM}macOS with bash reads ~/.bash_profile instead.${RST}

Lines you could add there:
  ${CMD}PS1='\$ '${RST}
  ${CMD}export PATH="\$HOME/bin:\$PATH"${RST}

${EM}Quit the tutor${RST}, open a new terminal, edit the file there. The tutor
will not touch it. Open another new terminal to see the change.

${INSTR}${G_PLAY} Read the lines, then type ${CMD}next${INSTR} to take the gate.${RST}
EOF
}

module_env_verify_task() {
    [ -f "$SANDBOX/env/seen.txt" ] || return 1
    [ "$(cat "$SANDBOX/env/seen.txt")" = "shell" ] || return 1
    return 0
}

module_env_gate() {
    PANEL_POS=gate
    show_screen recall <<EOF
${H1}env — gate${RST}

${SUB}Recall${RST} (three questions, all three must be correct).
Then a ${SUB}practical task${RST}.
EOF

    ask_question \
        "Q1: Which command makes a variable visible to the programs the shell starts?  (set, export, env, echo)" \
        "Lesson 2: it is the line you typed after setting pet, before the second bash -c." \
        'export' \
        -- \
        'export' \
        --reject \
        'wrong|incorrect|set|env|echo' || return $?

    ask_question \
        "Q2: What does ${CMD}PATH${RST} hold?  (a list of folders, one folder, a file name)" \
        "Lesson 3: you split it at each colon to read it; the order matters." \
        'a list of folders' \
        'list of folders' \
        'folders' \
        'a list' \
        'list' \
        'a list of directories' \
        'list of directories' \
        'directories' \
        -- \
        'folders|directories|a list|list of|places' || return $?

    ask_question \
        "Q3: You type ${CMD}PS1='me> '${RST}, then ${CMD}next${RST}. What is the prompt on the next screen?  (me> , shelltutor> )" \
        "Lesson 4: each screen starts a new shell." \
        'shelltutor>' \
        'shelltutor' \
        'it reverts' \
        'reverts' \
        'reverted' \
        -- \
        'shelltutor|shelltutor>' \
        --reject \
        'replaced|replaces|me>' || return $?

    # Clean slate once at task entry; learner state then persists across
    # in-gate `show` redisplays.
    setup_module_dir env
    rm -f "$SANDBOX/env/seen.txt" 2>/dev/null

    local hist_mark
    hist_mark=$(history_mark)

    PANEL_POS=task
    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}env — task${RST}

Prove that a child program can see a variable you exported. You will
work inside ${DIR}${SANDBOX}/env${RST}.

  1. set ${CMD}TOPIC${RST} to the word ${SUB}shell${RST}
  2. export it
  3. run a child ${CMD}bash -c${RST} that prints ${CMD}\$TOPIC${RST} into ${DIR}seen.txt${RST}
     ${DIM}(hint: single quotes, so the child replaces the variable)${RST}

${DIM}I will check: seen.txt holds the word shell, and your history shows${RST}
${DIM}TOPIC set, exported, and read inside single quotes by a child.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} when done.${RST}
EOF
        fi
        skip_screen=0
        practice "$SANDBOX/env"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if ! gate_require_history "$hist_mark" \
                    'set TOPIC to shell: TOPIC=shell' 'TOPIC=shell' \
                    'export TOPIC' 'export[[:space:]]+TOPIC' \
                    'a child bash -c that reads $TOPIC inside single quotes' \
                    '(ba)?sh[[:space:]]+-c[[:space:]]+'\''[^'\'']*\$\{?TOPIC'; then
                    attempt=$((attempt + 1))
                    gate_escalate "$attempt" \
                        "Set it, export it, then bash -c with single quotes around echo \$TOPIC and > seen.txt." \
                        "TOPIC=shell" "export TOPIC" "bash -c 'echo \$TOPIC' > seen.txt"
                    skip_screen=1
                    continue
                fi
                if module_env_verify_task; then
                    return 0
                fi
                attempt=$((attempt + 1))
                fb_begin
                if [ -f "$SANDBOX/env/seen.txt" ]; then
                    fb_ok "seen.txt exists"
                    fb_todo "seen.txt is shell" "it holds: $(head -n 1 "$SANDBOX/env/seen.txt" 2>/dev/null | tr -cd '[:print:]' | cut -c1-40)"
                else
                    fb_todo "seen.txt exists" "no seen.txt in this folder"
                fi
                fb_note "Expected: seen.txt holds the word shell."
                gate_escalate "$attempt" \
                    "Set it, export it, then bash -c with single quotes around echo \$TOPIC and > seen.txt." \
                    "TOPIC=shell" "export TOPIC" "bash -c 'echo \$TOPIC' > seen.txt"
                skip_screen=1
                ;;
            "$RC_QUIT") return $rc ;;
            *) : ;;
        esac
    done
}

module_env_cleared() {
    PANEL_POS=''
    show_screen module-cleared <<EOF
${H1}env cleared.${RST}

Commands and keys from this module:
$(recap_line 'name=value' 'set a variable in this shell')
$(recap_line 'export name' 'let child programs see it')
$(recap_line 'echo "$PATH"' 'the folders searched for programs')
$(recap_line env 'list what children receive')
$(recap_line "PS1='\$ '" 'change the prompt (this shell only)')

${INSTR}${G_PLAY} Type ${CMD}quit${INSTR} to leave, or ${CMD}next${INSTR} to return to the start of this module.${RST}
EOF
    practice "$SANDBOX/env"
    return $?
}

run_module_env() {
    PANEL_MODULE='env'
    setup_module_dir env
    local lessons=(module_env_intro module_env_lesson_1 module_env_lesson_2 module_env_lesson_3 module_env_lesson_4 module_env_lesson_5)
    local i rc
    while true; do
        i=0
        while [ "$i" -lt "${#lessons[@]}" ]; do
            PANEL_POS=''
            [ "$i" -ge 1 ] && PANEL_POS="$i of $((${#lessons[@]} - 1))"
            "${lessons[$i]}"
            rc=$?
            case "$rc" in
                "$RC_NEXT")  ((i++)) ;;
                "$RC_SHOW")  : ;;
                "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
        module_env_gate || return $?
        while true; do
            module_env_cleared
            rc=$?
            case "$rc" in
                "$RC_NEXT")  break ;;
                "$RC_SHOW"|"$RC_PREV") : ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to start again, or quit to leave.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
    done
}

run_module() {
    case "$1" in
        shells) run_module_shells ;;
        env) run_module_env ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------
# Stage dispatcher
# ---------------------------------------------------------------------

run_stage() {
    case "$1" in
        1) run_stage1 ;;
        2) run_stage2 ;;
        3) run_stage3 ;;
        4) run_stage4 ;;
        5) run_stage5 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------
# main
# ---------------------------------------------------------------------

main() {
    local start
    case "${1:-}" in
        -h|--help) usage; exit 0 ;;
        --info|-i) show_info; exit 0 ;;
        '')
            start=$(($(read_progress) + 1))
            if [ "$start" -gt "$TOTAL_STAGES" ]; then
                # Everything passed — show finale and exit.
                preflight || exit 1
                setup_sandbox
                finale
                exit 0
            fi
            ;;
        [1-5])
            start=$1
            ;;
        *)
            if module_known "$1"; then
                # A module is stand-alone: no stage loop, no .progress.
                preflight || exit 1
                setup_sandbox
                run_module "$1"
                exit 0
            fi
            echo "shelltutor: argument must be a stage number (1..5) or a module name ($MODULES)." >&2
            usage >&2
            exit 1
            ;;
    esac

    # Catch the most common "this won't work on your system" problems
    # with a one-sentence diagnostic before any lesson screen renders.
    preflight || exit 1

    setup_sandbox

    local s rc
    for ((s=start; s<=TOTAL_STAGES; s++)); do
        run_stage "$s"
        rc=$?
        if [ "$rc" -ne 0 ]; then
            # quit / interrupt — bail without finale; progress file already saved.
            exit 0
        fi
        if [ "$s" -lt "$TOTAL_STAGES" ]; then
            while true; do
                stage_cleared "$s"
                rc=$?
                case "$rc" in
                    "$RC_NEXT") break ;;
                    "$RC_SHOW"|"$RC_PREV") : ;;
                    "$RC_CHECK")
                        printf '\n%b(check is only for gate tasks. Type next to continue.)%b\n' "$DIM" "$RST"
                        sleep 2
                        ;;
                    *) exit 0 ;;
                esac
            done
        fi
    done

    finale
}

main "$@"
