stage4_intro() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}STAGE 4 — Commands, streams, composition${RST}
Four lessons, then a gate. You'll read a command's structure, check
whether a command exists, and chain commands together with pipes,
redirects, and globs.
Commands this stage:
  ${CMD}command -v${RST}   ask the shell if a program is installed
  ${CMD}wc${RST}           word, line, and character count
  ${CMD}seq${RST}           generate number sequences
  ${CMD}head${RST}          first N lines of input
  ${CMD}sort${RST}          sort lines
  ${CMD}grep${RST}          select lines matching a pattern
  ${CMD}|${RST}             ${BOLD}pipe${RST}: send one command's output into the next
  ${CMD}>${RST}             ${BOLD}redirect${RST}: write output to a file (overwrites)
  ${CMD}>>${RST}            ${BOLD}append${RST}: add output to the end of a file
  ${CMD}<${RST}             ${BOLD}input redirect${RST}: read a file into a command
  ${CMD}*${RST}             ${BOLD}glob${RST}: match many filenames at once

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to begin lesson 4.1.${RST}
EOF
}

stage4_lesson_1() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Reading a command${RST}

A shell command has a small grammar:
  ${BOLD}command  options  arguments${RST}

  ${CMD}ls -l /etc${RST}               ${DIM}# option + argument${RST}
  ${CMD}wc -l poem.txt${RST}           ${DIM}# count lines in a file${RST}
  ${CMD}echo "hello world"${RST}       ${DIM}# an argument with a space — quoted${RST}

${EM}Spaces matter.${RST}  The shell splits on spaces; ${BOLD}quote${RST} a name that has one:
  ${CMD}vim "my notes.txt"${RST}       ${DIM}# opens one file${RST}
  ${CMD}vim my notes.txt${RST}         ${DIM}# opens TWO files: 'my' and 'notes.txt'${RST}

${BOLD}command -v${RST} asks the shell whether a command exists:
  ${CMD}command -v ls${RST}            ${DIM}# prints the path; exits 0${RST}
  ${CMD}command -v vim${RST}           ${DIM}# does Vim exist on this system?${RST}

${INSTR}${G_PLAY} Try a few ${CMD}command -v${INSTR} probes, then ${CMD}next${INSTR}.${RST}
EOF
}

stage4_lesson_2() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}The pipe${RST}

A ${BOLD}pipe${RST} ( ${CMD}|${RST} ) sends one command's output into the next command's
input. ${EM}Most important idea in the shell.${RST}

${CMD}wc${RST} counts ${BOLD}whatever you piped in${RST}:
  ${CMD}wc -l poem.txt${RST}          ${DIM}# lines in poem.txt${RST}
  ${CMD}seq 1 100 | wc -l${RST}       ${DIM}# 100${RST}
  ${CMD}ls /usr/bin | wc -l${RST}     ${DIM}# how many programs are installed${RST}

Pipes stack:
  ${CMD}ls /usr/bin | sort | head${RST}        ${DIM}# list → sort → first 10${RST}
  ${CMD}ls /usr/bin | grep ^a${RST}            ${DIM}# names starting with 'a'${RST}
  ${CMD}ls /usr/bin | grep ^a | wc -l${RST}    ${DIM}# …and count them${RST}

Each piece is a normal command; only the connector is new. ${CMD}|${RST} is Shift+Backslash.

${INSTR}${G_PLAY} Try a few pipelines, then ${CMD}next${INSTR}.${RST}
EOF
}

stage4_lesson_3() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Redirection${RST}

A pipe sends output to ${BOLD}another program${RST}. A redirect sends it
to ${BOLD}a file${RST}, and ${CMD}>${RST} replaces it without asking, whoever typed the line.

  ${CMD}>${RST}    write to a file (${EM}overwrites${RST} if it exists)
  ${CMD}>>${RST}   append to a file (creates if missing)
  ${CMD}<${RST}    read a file ${BOLD}into${RST} a command

  ${CMD}echo first > greeting.txt${RST}        ${DIM}# overwrite${RST}
  ${CMD}echo second >> greeting.txt${RST}      ${DIM}# append${RST}
  ${CMD}cat greeting.txt${RST}                 ${DIM}# two lines${RST}
  ${CMD}wc -w < poem.txt${RST}                 ${DIM}# count words read from poem.txt${RST}

  ${CMD}ls /usr/bin | sort > programs.txt${RST}     ${DIM}# a pipe and a redirect together${RST}
  ${CMD}wc -l programs.txt${RST}

${INSTR}${G_PLAY} Try them, then type ${CMD}next${INSTR}.${RST}
EOF
}

stage4_lesson_4() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Globs${RST}

${BOLD}Globs${RST} match many filenames at once. The shell expands them
${BOLD}before${RST} the command sees them.

  ${CMD}ls *.txt${RST}              ${DIM}# every .txt file in this folder${RST}
  ${CMD}wc -l *.txt${RST}           ${DIM}# count lines in each .txt file${RST}
  ${CMD}cat *.txt${RST}             ${DIM}# print them all back-to-back${RST}

${EM}Predict before you act.${RST}  ${CMD}rm *${RST} removes everything
in the current folder. ${CMD}rm *.tmp${RST} removes only .tmp files.

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to take Stage 4's gate.${RST}
EOF
}

stage4_verify_task() {
    [ -f "$SANDBOX/stage4/count.txt" ] || return 1
