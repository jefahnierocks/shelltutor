stage4_intro() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Stage 4: Commands and streams${RST}

Six short lessons, then a task. You'll read a command's parts, then
join commands together and send what they print into files.
This stage runs in its own folder, stage4, with a few files the tutor put
there; ${CMD}pwd${RST} shows it.

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} for lesson 4.1.${RST}
EOF
    return $?
}

stage4_lesson_1() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}The parts of a command${RST}

A command line is a name, then options, then arguments.

  ${CMD}wc -l poem.txt${RST}         ${DIM}# name wc, option -l, argument poem.txt${RST}
  ${CMD}echo "hello world"${RST}     ${DIM}# one argument, because of the quotes${RST}
  ${CMD}command -v vim${RST}         ${DIM}# asks where a program lives, if it exists${RST}

${CMD}command -v${RST} prints a path when the program is installed, and nothing
when it is not.

${INSTR}${G_PLAY} Try all three, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage4_lesson_2() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Spaces and quotes${RST}

The shell splits a line on spaces. Quote a name that has a space.

  ${CMD}touch my notes.txt${RST}       ${DIM}# two files: my, and notes.txt${RST}
  ${CMD}ls${RST}
  ${CMD}touch "my notes.txt"${RST}     ${DIM}# one file with a space in its name${RST}
  ${CMD}ls${RST}

It is the same for every command: ${CMD}vim my notes.txt${RST} would open two
files; ${CMD}vim "my notes.txt"${RST} opens one.

${INSTR}${G_PLAY} Try them, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage4_lesson_3() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}The pipe${RST}

What a command prints is a stream of lines. A pipe, ${CMD}|${RST}, sends that stream
into the next command.

  ${CMD}seq 1 100 | wc -l${RST}              ${DIM}# seq prints 1 to 100; wc -l counts the lines${RST}
  ${CMD}ls /usr/bin | wc -l${RST}            ${DIM}# how many programs live there${RST}
  ${CMD}ls /usr/bin | sort | head${RST}      ${DIM}# pipes stack: list, sort, first ten${RST}

Each piece is an ordinary command. Only the connector is new. ${CMD}|${RST} is
${BOLD}Shift+Backslash${RST}.

${INSTR}${G_PLAY} Try all three, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage4_lesson_4() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Into a file${RST}

${CMD}>${RST} sends what a command prints into a file. ${CMD}>>${RST} adds to the end.

  ${CMD}echo first > greeting.txt${RST}      ${DIM}# writes over whatever was there${RST}
  ${CMD}echo second >> greeting.txt${RST}    ${DIM}# adds a line at the end${RST}
  ${CMD}cat greeting.txt${RST}               ${DIM}# two lines${RST}

${CMD}>${RST} replaces the file without asking, whoever typed the line.

${INSTR}${G_PLAY} Try all three, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage4_lesson_5() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Pipe, then file${RST}

A pipe and a ${CMD}>${RST} work in one line: the last command's output goes to
the file.

  ${CMD}ls /usr/bin | wc -l > count-of-programs.txt${RST}
  ${CMD}cat count-of-programs.txt${RST}      ${DIM}# one number${RST}

You'll do this in the task that follows.

${INSTR}${G_PLAY} Try both, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage4_lesson_6() {
    lesson "$SANDBOX/stage4" <<EOF
${H1}Many names at once${RST}

${CMD}*${RST} matches any run of characters in a file name. The shell fills in
the names before the command runs.

  ${CMD}ls *.txt${RST}         ${DIM}# every name ending in .txt${RST}
  ${CMD}wc -l *.txt${RST}      ${DIM}# count the lines in each one${RST}

A name with ${CMD}*${RST} in it is called a ${BOLD}glob${RST}. Predict before you act: ${CMD}rm *${RST}
would remove everything in the folder.

${INSTR}${G_PLAY} Try both, then type ${CMD}next${INSTR} for Stage 4's task.${RST}
EOF
    return $?
}

stage4_verify_task() {
    [ -f "$SANDBOX/stage4/count.txt" ] || return 1
    local content
    content=$(tr -d '[:space:]' < "$SANDBOX/stage4/count.txt" 2>/dev/null)
    [ "$content" = "100" ] || return 1
