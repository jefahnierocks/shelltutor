# Re-read the values the learner reported. The three task questions were
# asked just before this verification runs. Split into one check per answer
# so the gate can name which one did not match (never the expected value).
stage1_verify_whoami() {
    [ "${TASK_S1_WHOAMI:-x}" = "$(whoami 2>/dev/null)" ]
}

stage1_verify_pwd() {
    # pwd in the practice subshell prints $SANDBOX/stage1 (logical) or, if
    # the sandbox path crosses a symlink, its pwd -P form; accept either
    # after trimming surrounding whitespace (A1.7).
    local typed phys
    typed=$(printf '%s' "${TASK_S1_PWD:-}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -n "$typed" ] || return 1
    [ "$typed" = "$SANDBOX/stage1" ] && return 0
    phys=$(cd "$SANDBOX/stage1" 2>/dev/null && pwd -P) || return 1
    [ "$typed" = "$phys" ]
}

stage1_verify_task() {
    stage1_verify_whoami || return 1
    stage1_verify_pwd || return 1
    stage1_day_matches "${TASK_S1_DAY:-}" || return 1
    return 0
}

# Accept the day as `date` printed it in the learner's locale or as the
# English form the question lists. Case-insensitive; a trailing period is
# ignored (de_DE prints "Sa."); a full name also matches by its first three
# characters ("saturday" -> "sat"). A whole `date` line pasted in is also
# accepted when one of its words is the day (F-015, A2.4). See
# audit/2026-05-23/findings.md F-008 (no GNU sed case modifiers) and
# audit/2026-11-07/findings.md F-013.
stage1_day_matches() {
    local words w
    stage1_day_word_matches "$1" && return 0
    # Bash 3.2: here-string and read -a are fine; a non-empty array here.
    IFS=' ' read -r -a words <<< "$1"
    [ "${#words[@]}" -gt 1 ] || return 1
    for w in "${words[@]}"; do
        stage1_day_word_matches "$w" && return 0
    done
    return 1
}

stage1_day_word_matches() {
    local given cand norm
    given=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.$//')
    [ -n "$given" ] || return 1
    for cand in "$(LC_ALL=C date +%a)" "$(LC_ALL=C date +%A)" \
                "$(date +%a)" "$(date +%A)"; do
        norm=$(printf '%s' "$cand" | tr '[:upper:]' '[:lower:]' | sed 's/\.$//')
        [ -n "$norm" ] || continue
        [ "$given" = "$norm" ] && return 0
        case "$norm" in
            "$given"*) [ "${#given}" -ge 3 ] && return 0 ;;
        esac
    done
    return 1
}

# Verify the learner actually ran whoami / pwd / date during the task
# practice subshell. Called before the follow-up questions so they
# never see "what did pwd print?" if they didn't run pwd. Argument is
# a history-mark taken at task entry.
stage1_check_commands_run() {
    gate_require_history "$1" \
        "whoami" '^[[:space:]]*whoami([[:space:]]|$)' \
        "pwd"    '^[[:space:]]*pwd([[:space:]]|$)' \
        "date"   '^[[:space:]]*date([[:space:]]|$)'
}

# stage1_followup VAR PROMPT: ask one follow-up (transcription prompt, no
# ladder). `show` re-prints the follow-up block header and the question;
# `quit` or `exit` leaves with the farewell. Returns 1 on end of input.
stage1_followup() {
    local var="$1" prompt="$2" ans norm
    while true; do
        fb_note "$prompt"
        recall_prompt
        IFS= read -r ans < /dev/tty || return 1
        norm=$(normalize_answer "$ans")
        case "$norm" in
            show)
                printf '\n%bThree short follow-ups based on what you saw.%b\n\n' "$BOLD" "$RST"
                continue
                ;;
            quit|exit) farewell_exit ;;
        esac
        ans=$(printf '%s' "$ans" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        printf -v "$var" '%s' "$ans"
        return 0
    done
}

stage1_ask_whoami() {
    stage1_followup TASK_S1_WHOAMI "What did ${CMD}whoami${RST} print? (just the username)"
}

stage1_ask_pwd() {
    stage1_followup TASK_S1_PWD "What did ${CMD}pwd${RST} print? (paste the full path)"
}

stage1_ask_day() {
    stage1_followup TASK_S1_DAY "What day of the week did ${CMD}date${RST} show? Type just the day, for example Sat."
}

stage1_gate() {
    stage1_gate_screen

    ask_question \
        "Q1: In a normal bash window (not this tutor), which character usually ends the prompt? (\$, ;, :, or #)" \
        "Lesson 1.3: this tutor's prompt compared with a normal one." \
        '$' \
        'dollar' \
        'dollar sign' \
        'the dollar sign' \
        -- \
        '$|dollar' \
        --reject \
        'wrong|hash|pound|incorrect' || return $?

    ask_question \
        "Q2: What does ${CMD}pwd${RST} print?" \
        "Lesson 1.3: pwd answers a where question, not a who question." \
        'the current working directory' \
        'current working directory' \
        'the working directory' \
        'working directory' \
        'the current folder' \
        'current folder' \
        'the folder im in' \
        'the folder i am in' \
        'the folder' \
        'this folder' \
        'the directory' \
        'the current directory' \
        'current directory' \
        'where i am' \
        'the folder youre in' \
        'the folder you are in' \
        -- \
        'the folder|a folder|this folder|the current folder|current folder|the directory|current directory|working directory|where i am|where you are|your location|current location|the current path|the path i am in' \
        --reject \
        'cloud|python|user|browser|phone' || return $?

    ask_question \
        "Q3: After ${CMD}whoami${RST} runs, where does its output go?" \
        "Lesson 1.4: whoami printed something; think about where you read it." \
        'stdout' \
        'standard output' \
        'the screen' \
        'screen' \
        'the terminal' \
        'terminal' \
        'to the screen' \
        'on the screen' \
        'standard out' \
        'the terminal window' \
        'the display' \
        'it shows up on the screen' \
        'shows up on the screen' \
        'it comes back to me on the screen' \
        'comes back on the screen' \
        'back to me on the screen' \
        'the window' \
        'the window you type into' \
        'in the window you type into' \
        'back to me in the window you type into' \
        -- \
        'screen|terminal|the window|terminal window|back to you|back to me|straight back|stdout|standard output|standard out|display' \
        --reject \
        'browser|phone|file|printer|game|tab' || return $?

    # ---- Task: run three commands, then answer three short questions
    setup_stage_dir 1
    local hist_mark
    hist_mark=$(history_mark)

    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}STAGE 1 — GATE TASK${RST}

Inside the practice prompt, run each of these once. Read each output.
Then type ${CMD}check${RST}.

  ${CMD}whoami${RST}
  ${CMD}pwd${RST}
  ${CMD}date${RST}

After all three have run, I'll ask you what each one printed.
${DIM}Only commands you type after this screen count.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} only after running all three.${RST}
EOF
        fi
        skip_screen=0

        practice "$SANDBOX/stage1"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if ! stage1_check_commands_run "$hist_mark"; then
                    # Helper printed the missing-commands list. Re-enter
                    # the practice subshell with the same task — do NOT
                    # redisplay the task screen, so the missing-commands
                    # message stays visible above the new prompt.
                    attempt=$((attempt + 1))
                    gate_escalate "$attempt" \
                        "Run the command again and copy its output exactly." \
                        "whoami" "pwd" "date"
                    skip_screen=1
                    continue
                fi
                printf '%bThree short follow-ups based on what you saw.%b\n\n' "$BOLD" "$RST"
                stage1_ask_whoami || return 1
                printf '\n'
                stage1_ask_pwd || return 1
                printf '\n'
                stage1_ask_day || return 1

                # On a mismatch re-ask only the item(s) that failed (A2.4);
                # the task restarts only on quit or a failed history check.
                local fattempt=0
                until stage1_verify_task; do
                    fattempt=$((fattempt + 1))
                    # Name which answer failed, never the expected value.
                    fb_begin
                    if stage1_verify_whoami; then fb_ok "whoami answer"
                    else fb_todo "whoami answer" "your answer differs from the whoami line"; fi
                    if stage1_verify_pwd; then fb_ok "pwd answer"
                    else fb_todo "pwd answer" "your answer differs from the pwd line"; fi
                    if stage1_day_matches "${TASK_S1_DAY:-}"; then fb_ok "day answer"
                    else fb_todo "day answer" "your answer differs from the date line"; fi
                    fb_note "Look back at what each command printed, then answer the one marked ${G_BOX_TODO} again."
                    gate_escalate "$fattempt" \
                        "Each answer is exactly what that command printed: your user name, the full folder path, the day."
                    stage1_verify_whoami || { stage1_ask_whoami || return 1; printf '\n'; }
                    stage1_verify_pwd || { stage1_ask_pwd || return 1; printf '\n'; }
                    stage1_day_matches "${TASK_S1_DAY:-}" || { stage1_ask_day || return 1; printf '\n'; }
                done
                save_progress 1
                return 0
                ;;
            "$RC_QUIT")
                return $rc
                ;;
            *)
                # show/prev/next at a gate → redisplay task
                ;;
        esac
    done
}

run_stage1() {
    local lessons=(welcome orientation stage1_intro stage1_lesson_1 stage1_lesson_2 stage1_lesson_3 stage1_lesson_4 stage1_lesson_5)
    local i=0
    while [ "$i" -lt "${#lessons[@]}" ]; do
        panel_at 1 "${lessons[$i]}"
        "${lessons[$i]}"
        local rc=$?
        case "$rc" in
            "$RC_NEXT")  ((i++)) ;;
            "$RC_SHOW")  : ;;
            "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
            "$RC_CHECK")
                # `check` only verifies a gate task; at a lesson it is
                # a no-op. Print a one-line note, pause briefly so the
                # learner can read it, then re-display the lesson via
                # the loop's default (i unchanged).
                printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                sleep 2
                ;;
            *)         return "$rc" ;;
        esac
    done
    PANEL_STAGE=1; PANEL_POS=task
    stage1_gate
}

