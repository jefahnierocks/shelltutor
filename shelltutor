# STAGE 5 — Ready for vimtutor
# ---------------------------------------------------------------------

stage5_intro() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}STAGE 5 — Ready for vimtutor${RST}

Five lessons, then a gate. By the end, you'll know the difference
between a command that prints-and-exits and one that takes over the
terminal; you'll be able to leave any of them deliberately; and you'll
understand why Vim has ${CMD}:w${RST}, ${CMD}:q${RST}, and ${CMD}:q!${RST}.

After the gate, this tutor hands you to ${CMD}vimtutor${RST} (if it's
installed on your system) — that is the next step.

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to begin lesson 5.1.${RST}
EOF
}

stage5_lesson_1() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}Print-and-exit vs full-screen${RST}

Most of the commands you've used print output and return immediately:
  ${CMD}ls${RST}          ${CMD}date${RST}          ${CMD}wc -l file${RST}

Other commands ${EM}take over the screen${RST} until you exit them:
  ${CMD}man ls${RST}              ${DIM}# the manual page for ls${RST}
  ${CMD}less long-file.txt${RST}  ${DIM}# page through a long file${RST}
  ${CMD}vim file${RST}            ${DIM}# the Vim editor${RST}

While one runs, the shell prompt is ${BOLD}gone${RST}: you're inside a program,
and the same keys may do different things there.

${BOLD}Exit keys${RST}:  ${CMD}man${RST} and ${CMD}less${RST} ${BOLD}q${RST}   ·   ${CMD}vim${RST} ${CMD}:q${RST} then Enter (Lesson 5.3)
Try one: ${CMD}man ls${RST}, then ${BOLD}q${RST} to come back.

${INSTR}${G_PLAY} When back at ${DIM}shelltutor>${INSTR}, type ${CMD}next${INSTR}.${RST}
EOF
}

stage5_lesson_2() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}Entering and leaving Vim${RST}

${CMD}vim${RST} is a text editor. Before you ${BOLD}edit${RST} anything,
let's learn how to ${BOLD}leave${RST}.

First, see if Vim is installed:
  ${CMD}command -v vim${RST}   ${DIM}# a path means it is; if not, install it${RST}

A safe entrance, then a full session with no file:
  ${CMD}vim --version${RST}   ${DIM}# prints version info and exits${RST}
  ${CMD}vim${RST}             ${DIM}# leave with ${RST}${CMD}:q${RST}${DIM} then Enter${RST}

If Vim refuses (unsaved changes), use the ${EM}discard${RST} form:
  ${CMD}:q!${RST} then Enter

${EM}You will need :q!${RST} the first few times you use Vim. Memorize it.

${INSTR}${G_PLAY} Try ${CMD}vim --version${INSTR} and ${CMD}vim${INSTR} (then ${CMD}:q${INSTR}). Then ${CMD}next${INSTR}.${RST}
EOF
}

stage5_lesson_3() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}Buffer vs file${RST}

${EM}The most important idea in this stage.${RST} When you open a file in
Vim, Vim ${BOLD}reads it into a buffer${RST} — a copy in memory. Your
keystrokes change the ${BOLD}buffer${RST}, not the file. The file on disk
only changes when you ${BOLD}write${RST} the buffer back.

  ${BOLD}file on disk${RST}  →  ${BOLD}buffer in memory${RST}  →  ${BOLD}file on disk${RST}
       (read)                  (edit)                     (write)

That's why Vim has separate commands for save and quit:
  ${CMD}:w${RST}    write the buffer to the file
  ${CMD}:q${RST}    quit (only if there are no unsaved changes)
  ${CMD}:q!${RST}   quit and discard unsaved changes
  ${CMD}:wq${RST}   write, then quit

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to practise both.${RST}
EOF
}

stage5_lesson_4() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}Practice: discard, then save${RST}

${EM}Practice on a file you don't mind editing.${RST}  A practice.txt${RST}
fixture is in this stage's folder. Try:

  ${CMD}vim practice.txt${RST}
     type ${CMD}i${RST} to enter insert mode (vimtutor will teach modes)
     type a few letters
     press ${BOLD}Esc${RST}
     type ${CMD}:q!${RST} then Enter
     ${CMD}cat practice.txt${RST}   ${DIM}# the file is unchanged${RST}

  ${CMD}vim practice.txt${RST}
     type ${CMD}i${RST}, then a few letters, ${BOLD}Esc${RST}
     type ${CMD}:wq${RST}, Enter
     ${CMD}cat practice.txt${RST}   ${DIM}# now the file has changed${RST}

${INSTR}${G_PLAY} Try both, then ${CMD}next${INSTR}.${RST}
EOF
}

stage5_lesson_5() {
    lesson "$SANDBOX/stage5" <<EOF
${H1}Calling vimtutor${RST}

${CMD}vimtutor${RST} is itself a shell command. It launches Vim on a ${BOLD}copy${RST}
of a tutorial file so you can practice without damaging the original.

Check whether it's installed:
  ${CMD}command -v vimtutor${RST}

If it prints a path, you're set. If not:
  - Linux: install your distro's full ${BOLD}vim${RST} package (not ${BOLD}vim-minimal${RST}).
  - macOS: ${CMD}vimtutor${RST} may not be on PATH; ${CMD}brew install vim${RST} adds it.

This stage's gate runs the practice from 5.4 once more, then you'll be done.

${INSTR}${G_PLAY} Type ${CMD}next${INSTR} to take Stage 5's gate.${RST}
EOF
}

# Stage 5 verification is two-phase. The script controls a known starting
# state for practice.txt and re-verifies between phases.

stage5_seed_practice() {
    setup_stage_dir 5
    echo before > "$SANDBOX/stage5/practice.txt"
}

stage5_verify_phase1() {
    # phase 1: learner opened, edited, did NOT save. File should still say 'before'.
    [ -f "$SANDBOX/stage5/practice.txt" ] || return 1
    local content
    content=$(cat "$SANDBOX/stage5/practice.txt" 2>/dev/null)
    [ "$content" = "before" ] || return 1
    return 0
}

stage5_verify_phase2() {
    # phase 2: learner opened, edited, SAVED. File should differ from 'before'.
    [ -f "$SANDBOX/stage5/practice.txt" ] || return 1
    local content
    content=$(cat "$SANDBOX/stage5/practice.txt" 2>/dev/null)
    [ "$content" != "before" ] || return 1
    # also: file should be non-empty
    [ -s "$SANDBOX/stage5/practice.txt" ] || return 1
    return 0
}

stage5_gate() {
    show_screen recall <<EOF
${H1}STAGE 5 — GATE${RST}

${BOLD}Recall${RST} (three questions, all three must be correct).
Then a ${BOLD}two-phase practical task${RST}.
EOF

    ask_question \
        "Q1: How do you exit ${CMD}man ls${RST}?" \
        "Lesson 5.1: the same single key leaves ${CMD}less${RST}." \
        'q' \
        'press q' \
        'type q' \
        'the q key' \
        -- \
        'q' \
        --reject \
        'delete|question|everything|wrong|rm' || return $?

    ask_question \
        "Q2: After ${CMD}vim notes.txt${RST}, what makes Vim write your edit to the file?" \
        "Lesson 5.3: the colon command for putting the buffer into the file." \
        ':w' \
        ':w<enter>' \
        ':w then enter' \
        ':wq' \
        ':wq<enter>' \
        ':wq then enter' \
        'write command' \
        ':write' \
        'colon w' \
        -- \
        ':w|:wq|w|write|writes|write it|save|saves' \
        --reject \
        'game|delete|deleting|deletes|erase' || return $?

    ask_question \
        "Q3: If you open notes.txt${RST} in ${CMD}vim${RST}, type some letters, and quit with ${CMD}:q!${RST} — did the file on disk change?" \
        "Lesson 5.3: the buffer is a copy; the disk only changes when you write it." \
        'no' \
        'no it did not' \
        'no it didnt' \
        "no it didn't" \
        'no the file did not change' \
        'no, the file did not change' \
        'unchanged' \
        'it did not change' || return $?

    # Phase 1: open, edit, discard. File must still read 'before' afterward.
    local skip_screen=0 attempt=0
    while true; do
        stage5_seed_practice
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}STAGE 5 — GATE TASK (phase 1 of 2)${RST}

I've reset practice.txt${RST} to contain just the word ${BOLD}before${RST}.

At the practice prompt:

  1. ${CMD}cat practice.txt${RST}        ${DIM}# confirm it says 'before'${RST}
  2. ${CMD}vim practice.txt${RST}
       ${CMD}i${RST}  ${DIM}# enter insert mode${RST}
       type a few letters
       ${BOLD}Esc${RST}
       ${CMD}:q!${RST}  Enter   ${DIM}# discard your changes${RST}
  3. ${CMD}cat practice.txt${RST}        ${DIM}# should still say 'before'${RST}

Then type ${CMD}check${RST}.
${DIM}I will verify the file is still exactly 'before'.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} when done.${RST}
EOF
        fi
        skip_screen=0
        practice "$SANDBOX/stage5"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if stage5_verify_phase1; then
                    printf '\n%b%s Phase 1 verified — the file was unchanged.%b\n\n' "$OK" "$G_BOX_OK" "$RST"
                    break
                fi
                attempt=$((attempt + 1))
                fb_begin
                fb_todo "practice.txt is before" "it no longer reads exactly before"
                fb_note "Did you use ${CMD}:wq${RST} instead of ${CMD}:q!${RST}? I'll reset it; try phase 1 again,"
                fb_note "then type ${CMD}check${RST}."
                gate_escalate "$attempt" \
                    ":q! throws the change away; :wq would write it." \
                    "vim practice.txt" "i" "type a letter" "Esc" ":q!"
                skip_screen=1
                ;;
            "$RC_QUIT") return $rc ;;
            *) : ;;
        esac
    done

    # Phase 2: open, edit, save. File must differ from 'before' afterward.
    skip_screen=0 attempt=0
    while true; do
        # Don't reset between phases — the learner should see their phase-1
        # 'before' state and edit forward from it.
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}STAGE 5 — GATE TASK (phase 2 of 2)${RST}

Now save a real edit.

  1. ${CMD}vim practice.txt${RST}
       ${CMD}i${RST}, type at least one letter, ${BOLD}Esc${RST}
       ${CMD}:wq${RST}  Enter   ${DIM}# write and quit${RST}
  2. ${CMD}cat practice.txt${RST}        ${DIM}# now it differs from 'before'${RST}

Then type ${CMD}check${RST}.

${DIM}I will verify the file is no longer exactly 'before'.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} when done.${RST}
EOF
        fi
        skip_screen=0
        practice "$SANDBOX/stage5"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if stage5_verify_phase2; then
                    printf '\n%b%s Phase 2 verified — the file was written.%b\n\n' "$OK" "$G_BOX_OK" "$RST"
                    printf '%b%s Stage 5 cleared.%b\n\n' "$OK" "$G_BOX_OK" "$RST"
                    save_progress 5
                    return 0
                fi
                attempt=$((attempt + 1))
                fb_begin
                fb_todo "practice.txt changed" "it still reads exactly before"
                fb_note "Did you use ${CMD}:q!${RST} instead of ${CMD}:wq${RST}? Try again,"
                fb_note "then type ${CMD}check${RST}."
                gate_escalate "$attempt" \
                    ":wq writes the buffer to the file, then quits." \
                    "vim practice.txt" "i" "type a letter" "Esc" ":wq"
                skip_screen=1
                ;;
            "$RC_QUIT") return $rc ;;
            *) : ;;
        esac
    done
}

run_stage5() {
    setup_stage_dir 5
    local lessons=(stage5_intro stage5_lesson_1 stage5_lesson_2 stage5_lesson_3 stage5_lesson_4 stage5_lesson_5)
    local i=0
    while [ "$i" -lt "${#lessons[@]}" ]; do
        panel_at 5 "${lessons[$i]}"
        "${lessons[$i]}"
        local rc=$?
        case "$rc" in
            "$RC_NEXT")  ((i++)) ;;
            "$RC_SHOW")  : ;;
            "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
            "$RC_CHECK")
                # `check` only verifies a gate task; at a lesson it is
                # a no-op. Print a one-line note, pause briefly so the
                # learner can read it, then re-display the lesson via
                # the loop's default (i unchanged).
                printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                sleep 2
                ;;
            *)         return "$rc" ;;
        esac
    done
    PANEL_STAGE=5; PANEL_POS=task
    stage5_gate
}

