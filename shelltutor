# ---------------------------------------------------------------------
# Recall-question helper
#
# Usage: ask_question "<prompt>" <accepted-answer>...
# - Reads input from /dev/tty so it works inside the parent shell.
# - Normalizes by lowercasing + trimming whitespace.
# - Accepts the answer if it matches any of the trailing arguments
#   (also normalized). Loops until correct. No hints, no answer reveal.
# - Returns 0 on correct answer. (Quit via Ctrl+C at the parent shell.)
# ---------------------------------------------------------------------

# Lower-case, collapse any run of whitespace to one space, trim the ends.
# tr -s is POSIX; GNU sed's \+ is not (audit/2026-11-07/findings.md F-012).
normalize_answer() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' \
        | sed 's/^ //; s/ $//'
}

ask_question() {
    local prompt="$1"; shift
    local accept=("$@")
    local ans norm ok_norm matched
    while true; do
        printf '%b%b%b\n' "$Q" "$prompt" "$RST"
        printf '  %byour answer:%b ' "$CMD" "$RST"
        if ! IFS= read -r ans < /dev/tty; then
            printf '\n'
            return 1
        fi
        norm=$(normalize_answer "$ans")
        matched=0
        for ok in "${accept[@]}"; do
            ok_norm=$(normalize_answer "$ok")
            if [ "$norm" = "$ok_norm" ]; then
                matched=1; break
            fi
        done
        if [ "$matched" -eq 1 ]; then
            printf '  %b%s%b\n\n' "$OK" "$G_OK" "$RST"
            return 0
        fi
        printf '  %bnot quite. try again.%b\n\n' "$EM" "$RST"
    done
}

# ---------------------------------------------------------------------
# History helpers
# ---------------------------------------------------------------------

# Marks the current size of HISTFILE; later, history_since_marker shows
# only lines added since.
history_mark() {
    [ -f "$SANDBOX/.shelltutor_history" ] || touch "$SANDBOX/.shelltutor_history"
    wc -l < "$SANDBOX/.shelltutor_history" 2>/dev/null | tr -d '[:space:]'
}

history_since() {
    local mark=$1
    local total
    total=$(wc -l < "$SANDBOX/.shelltutor_history" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$total" ] || [ "$total" -le "$mark" ]; then
        return 0
    fi
    tail -n "$((total - mark))" "$SANDBOX/.shelltutor_history"
}

# ---------------------------------------------------------------------
# Gate feedback (A3.4): a checklist inside a bar. Every line of the block
# starts with the bar in INSTR. fb_ok marks what the gate saw done, fb_todo
# what it did not, with "not yet: <what it sees instead>". Wording is not
# contractual (C-006); the shape is.
# ---------------------------------------------------------------------

fb_begin() { printf '\n'; }

# fb_note TEXT  -> "┃ TEXT"
fb_note() {
    printf '%s%s%s %s\n' "$INSTR" "$G_BAR" "$RST" "$1"
}

# fb_ok LABEL
fb_ok() {
    printf '%s%s%s %s%-2s%s %s\n' "$INSTR" "$G_BAR" "$RST" "$OK" "$G_OK" "$RST" "$1"
}

# fb_todo LABEL WHY
fb_todo() {
    printf '%s%s%s %s%-2s%s %-14s %s%s%s\n' "$INSTR" "$G_BAR" "$RST" \
        "$DIM" "$G_TODO" "$RST" "$1" "$DIM" "not yet: $2" "$RST"
}

# gate_require_history MARK LABEL ERE [LABEL ERE ...]
# Looks at the practice-shell commands recorded since MARK (a history_mark
# value). Each ERE is matched with grep -E against the recorded lines.
# Prints a checklist (ticked for seen, "not yet" for missing) and returns 1
# when any LABEL's ERE never matched; prints nothing and returns 0 when
# everything was seen.
gate_require_history() {
    local mark="$1"; shift
    local recent label pattern
    local labels=() seen=() missing=0
    recent=$(history_since "$mark")
    while [ "$#" -ge 2 ]; do
        label="$1"; pattern="$2"; shift 2
        labels+=("$label")
        if printf '%s\n' "$recent" | grep -qE "$pattern"; then
            seen+=(1)
        else
            seen+=(0); missing=$((missing + 1))
        fi
    done
    # Return before expanding "${labels[@]}": on Bash 3.2 an empty array
    # expansion is an unbound-variable error under set -u.
    [ "$missing" -eq 0 ] && return 0
    local i=0
    fb_begin
    for label in "${labels[@]}"; do
        if [ "${seen[$i]}" = 1 ]; then
            fb_ok "$label"
        else
            fb_todo "$label" "not in your history"
        fi
        i=$((i + 1))
    done
    fb_note "Run the ones marked ${G_TODO}, then type ${CMD}check${RST} again."
    return 1
}

# gate_escalate ATTEMPT HINT EXAMPLE...
# attempt 1: nothing extra (the gate already printed what it saw).
# attempt 2: HINT. attempt 3+: HINT plus the worked EXAMPLE lines, which
# the learner still has to type themselves. There is no auto-pass. The
# hint and example continue the feedback bar; a blank line ends the block.
gate_escalate() {
    local attempt="$1" hint="$2"; shift 2
    if [ "$attempt" -ge 2 ]; then
        fb_note "${SUB}Hint:${RST} $hint"
        if [ "$attempt" -ge 3 ]; then
            fb_note "${SUB}Worked example — type these yourself:${RST}"
            local line
            for line in "$@"; do
                fb_note "  ${CMD}${line}${RST}"
            done
        fi
    fi
    printf '\n'
}

