}

# The file must exist and hold exactly what `command -v zsh` prints on this
# machine (nothing, when zsh is not installed). The tutor's PATH is the
# practice shell's PATH.
module_shells_verify_task() {
    local want
    want=$(command -v zsh 2>/dev/null || true)
    [ -f "$SANDBOX/shells/zsh.txt" ] || return 1
    [ "$(cat "$SANDBOX/shells/zsh.txt")" = "$want" ] || return 1
    return 0
}

module_shells_gate() {
    PANEL_POS=gate
    show_screen recall <<EOF
${H1}shells — gate${RST}

${SUB}Recall${RST} (three questions, all three must be correct).
Then a ${SUB}practical task${RST}.
EOF

    ask_question \
        "Q1: The shell runs the programs you name. What kind of thing is the shell itself?  (a program, a file, a folder, a window)" \
        "Lesson 1: it showed up in ps next to the commands you ran." \
        'a program' \
        'program' \
        "it's a program" \
        'its a program' \
        -- \
        'program' \
        --reject \
        'folder|file|window' || return $?

    ask_question \
        "Q2: What do you type to ask whether zsh is installed?" \
        "Lesson 2: asking about two names at once." \
        'command -v zsh' \
        'command -v' \
        'which zsh' \
        'type zsh' \
        -- \
        'command -v zsh|which zsh|type zsh' || return $?

    ask_question \
        "Q3: ${CMD}echo \$SHELL${RST} prints which shell?  (the running one, your login shell, the newest one)" \
        "Lesson 3: it is the one a new terminal window starts, and it can differ from the shell running now." \
        'login shell' \
        'your login shell' \
        'the login shell' \
        'login' \
        -- \
        'login' \
        --reject \
        'window|screen|page' || return $?

    # Clean slate once at task entry; learner state then persists across
    # in-gate `show` redisplays.
    setup_module_dir shells
    rm -f "$SANDBOX/shells/zsh.txt" 2>/dev/null

    local hist_mark
    hist_mark=$(history_mark)

    PANEL_POS=task
    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}shells — task${RST}

Find out whether ${CMD}zsh${RST} is installed here, and record the answer in a
file. You will work inside ${DIR}${SANDBOX}/shells${RST}.

  1. ask the shell where ${CMD}zsh${RST} is
  2. send what it prints to a file named ${DIR}zsh.txt${RST}
     ${DIM}(hint: Stage 4's ${CMD}>${RST}${DIM} sends output to a file)${RST}

If zsh is not installed, the shell prints nothing, and the file is
empty. That is a correct answer.

${DIM}I will check: zsh.txt exists and holds exactly what ${RST}${CMD}command -v zsh${RST}
${DIM}prints on this machine, and your history shows you asked.${RST}

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} when done.${RST}
EOF
        fi
        skip_screen=0
        practice "$SANDBOX/shells"
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if ! gate_require_history "$hist_mark" \
                    "ask the shell where zsh is: command -v zsh" \
                    'command[[:space:]]+-v[[:space:]]+zsh'; then
                    attempt=$((attempt + 1))
                    gate_escalate "$attempt" \
                        "command -v zsh prints where zsh is, or nothing; > sends it to a file." \
                        "command -v zsh > zsh.txt"
                    skip_screen=1
                    continue
                fi
                if module_shells_verify_task; then
                    return 0
                fi
                attempt=$((attempt + 1))
                fb_begin
                if [ -f "$SANDBOX/shells/zsh.txt" ]; then
                    fb_ok "zsh.txt exists"
                    fb_todo "zsh.txt content" "it holds: $(head -n 1 "$SANDBOX/shells/zsh.txt" 2>/dev/null | tr -cd '[:print:]' | cut -c1-40)"
                else
                    fb_todo "zsh.txt exists" "no zsh.txt in this folder"
                fi
                if [ -n "$(command -v zsh 2>/dev/null || true)" ]; then
                    fb_note "Expected: the path zsh is installed at."
                else
                    fb_note "Expected: an empty file (zsh is not installed here)."
                fi
                gate_escalate "$attempt" \
                    "command -v zsh prints where zsh is, or nothing; > sends it to a file." \
                    "command -v zsh > zsh.txt"
                skip_screen=1
                ;;
            "$RC_QUIT") return $rc ;;
            *) : ;;
        esac
    done
}

module_shells_cleared() {
    PANEL_POS=''
    show_screen module-cleared <<EOF
${H1}shells cleared.${RST}

Commands and keys from this module:
$(recap_line 'echo $BASH_VERSION' 'the shell running now')
$(recap_line ps 'the shell is one of the running programs')
$(recap_line 'command -v NAME' 'is NAME installed, and where')
$(recap_line 'echo $SHELL' 'your login shell')

${INSTR}${G_PLAY} Type ${CMD}quit${INSTR} to leave, or ${CMD}next${INSTR} to start this module again.${RST}
EOF
    practice "$SANDBOX/shells"
    return $?
}

run_module_shells() {
    PANEL_MODULE=shells
    setup_module_dir shells
    local lessons=(module_shells_intro module_shells_lesson_1 module_shells_lesson_2 module_shells_lesson_3)
    local i rc
    while true; do
        i=0
        while [ "$i" -lt "${#lessons[@]}" ]; do
            PANEL_POS=''
            [ "$i" -ge 1 ] && PANEL_POS="$i of $((${#lessons[@]} - 1))"
            "${lessons[$i]}"
            rc=$?
            case "$rc" in
                "$RC_NEXT")  ((i++)) ;;
                "$RC_SHOW")  : ;;
                "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
        module_shells_gate || return $?
        while true; do
            module_shells_cleared
            rc=$?
            case "$rc" in
                "$RC_NEXT")  break ;;
                "$RC_SHOW"|"$RC_PREV") : ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to start again, or quit to leave.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
    done
}

