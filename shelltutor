    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen gate <<EOF
${H1}STAGE 4 — GATE TASK${RST}

Work inside ${SANDBOX}/stage4${RST}.

Do these:

