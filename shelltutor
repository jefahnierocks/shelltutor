    content=$(tr -d '[:space:]' < "$SANDBOX/stage4/count.txt" 2>/dev/null)
    [ "$content" = "100" ] || return 1
    # Bonus: confirm at least one .txt file exists alongside count.txt to make
    # the "list .txt files" portion meaningful. The setup creates a stub.
    return 0
}

stage4_gate() {
    show_screen recall <<EOF
${H1}STAGE 4 — GATE${RST}

${BOLD}Recall${RST} (three questions, all three must be correct).
Then a ${BOLD}practical task${RST}.
EOF

    ask_question \
        "Q1: What does ${CMD}command -v vim${RST} print, if Vim is installed?" \
        "Lesson 4.1: command -v asks the shell about a command and answers in one line." \
        'the path to vim' \
        'path to vim' \
        'a path' \
        'the path' \
        'where vim is' \
        "vim's path" \
        'vims path' \
        '/usr/bin/vim' \
        'the path /usr/bin/vim' \
        'the path to the vim program' \
        'where the vim program is' \
        'where the program file is' \
        'the location of vim' \
        "vim's location" \
