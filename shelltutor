# Re-read the values the learner reported. The three task questions were
# asked just before this verification runs. Split into one check per answer
# so the gate can name which one did not match (never the expected value).
stage1_verify_whoami() {
    [ "${TASK_S1_WHOAMI:-x}" = "$(whoami 2>/dev/null)" ]
}

stage1_verify_pwd() {
    # pwd in practice subshell == $SANDBOX/stage1
    [ "${TASK_S1_PWD:-x}" = "$SANDBOX/stage1" ]
}

stage1_verify_task() {
    stage1_verify_whoami || return 1
    stage1_verify_pwd || return 1
    stage1_day_matches "${TASK_S1_DAY:-}" || return 1
    return 0
}

# Accept the day as `date` printed it in the learner's locale or as the
# English form the question lists. Case-insensitive; a trailing period is
# ignored (de_DE prints "Sa."); a full name also matches by its first three
# characters ("saturday" -> "sat"). See audit/2026-05-23/findings.md F-008
# (no GNU sed case modifiers) and audit/2026-11-07/findings.md F-013.
stage1_day_matches() {
    local given cand norm
    given=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.$//')
    [ -n "$given" ] || return 1
    for cand in "$(LC_ALL=C date +%a)" "$(LC_ALL=C date +%A)" \
                "$(date +%a)" "$(date +%A)"; do
        norm=$(printf '%s' "$cand" | tr '[:upper:]' '[:lower:]' | sed 's/\.$//')
        [ -n "$norm" ] || continue
        [ "$given" = "$norm" ] && return 0
        case "$norm" in
            "$given"*) [ "${#given}" -ge 3 ] && return 0 ;;
        esac
    done
    return 1
}

# Verify the learner actually ran whoami / pwd / date during the task
# practice subshell. Called before the follow-up questions so they
# never see "what did pwd print?" if they didn't run pwd. Argument is
# a history-mark taken at task entry.
stage1_check_commands_run() {
    gate_require_history "$1" \
        "whoami" '^[[:space:]]*whoami([[:space:]]|$)' \
        "pwd"    '^[[:space:]]*pwd([[:space:]]|$)' \
        "date"   '^[[:space:]]*date([[:space:]]|$)'
}

stage1_gate() {
    stage1_gate_screen

    ask_question \
        "Q1: Which character usually ends a shell prompt? (\$, ;, :, or #)" \
        '$' || return $?

    ask_question \
        "Q2: What does ${CMD}pwd${RST} print?" \
        'the current working directory' \
        'current working directory' \
        'the working directory' \
        'working directory' \
        'the current folder' \
        'current folder' \
        'the folder im in' \
        'the folder i am in' || return $?

    ask_question \
        "Q3: After ${CMD}whoami${RST} runs, where does its output go?" \
        'stdout' \
        'standard output' \
        'the screen' \
        'screen' \
        'the terminal' \
        'terminal' || return $?

    # ---- Task: run three commands, then answer three short questions
    setup_stage_dir 1
    local hist_mark
    hist_mark=$(history_mark)

    local skip_screen=0 attempt=0
    while true; do
        if [ "$skip_screen" -eq 0 ]; then
            show_screen <<EOF
${H1}STAGE 1 — GATE TASK${RST}

Inside the practice prompt, run each of these once. Read each output.
Then type ${CMD}check${RST}.

  ${CMD}whoami${RST}
  ${CMD}pwd${RST}
  ${CMD}date${RST}

After all three have run, I'll ask you what each one printed.

${INSTR}${G_PLAY} Type ${CMD}check${INSTR} only after running all three.${RST}
EOF
        fi
        skip_screen=0

        practice "$SANDBOX/stage1" gate
        local rc=$?
        case "$rc" in
            "$RC_CHECK")
                if ! stage1_check_commands_run "$hist_mark"; then
                    # Helper printed the missing-commands list. Re-enter
                    # the practice subshell with the same task — do NOT
                    # redisplay the task screen, so the missing-commands
                    # message stays visible above the new prompt.
                    attempt=$((attempt + 1))
                    gate_escalate "$attempt" \
                        "Run the command again and copy its output exactly." \
                        "whoami" "pwd" "date"
                    skip_screen=1
                    continue
                fi
                printf '%bThree short follow-ups based on what you saw.%b\n\n' "$SUB" "$RST"

                printf '%bWhat did %bwhoami%b print? (just the username)%b\n' "$Q" "$CMD" "$Q" "$RST"
                printf '  %byour answer:%b ' "$CMD" "$RST"
                IFS= read -r TASK_S1_WHOAMI < /dev/tty || return 1
                TASK_S1_WHOAMI=$(printf '%s' "$TASK_S1_WHOAMI" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

                printf '\n%bWhat did %bpwd%b print? (paste the full path)%b\n' "$Q" "$CMD" "$Q" "$RST"
                printf '  %byour answer:%b ' "$CMD" "$RST"
                IFS= read -r TASK_S1_PWD < /dev/tty || return 1
                TASK_S1_PWD=$(printf '%s' "$TASK_S1_PWD" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

                printf '\n%bWhat day of the week did %bdate%b show? (Mon, Tue, … — or exactly as date printed it)%b\n' "$Q" "$CMD" "$Q" "$RST"
                printf '  %byour answer:%b ' "$CMD" "$RST"
                IFS= read -r TASK_S1_DAY < /dev/tty || return 1
                TASK_S1_DAY=$(printf '%s' "$TASK_S1_DAY" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

                if stage1_verify_task; then
                    save_progress 1
                    return 0
                fi
                attempt=$((attempt + 1))
                # Name which answer failed, never the expected value.
                fb_begin
                if stage1_verify_whoami; then fb_ok "whoami answer"
                else fb_todo "whoami answer" "that is not what whoami printed"; fi
                if stage1_verify_pwd; then fb_ok "pwd answer"
                else fb_todo "pwd answer" "that is not what pwd printed"; fi
                if stage1_day_matches "${TASK_S1_DAY:-}"; then fb_ok "day answer"
                else fb_todo "day answer" "that is not the day date printed"; fi
                fb_note "Run the commands again and read what they print, then type ${CMD}check${RST} again."
                gate_escalate "$attempt" \
                    "Run the command again and copy its output exactly." \
                    "whoami" "pwd" "date"
                skip_screen=1
                ;;
            "$RC_QUIT")
                return $rc
                ;;
            *)
                # show/prev/next at a gate → redisplay task
                ;;
        esac
    done
}

run_stage1() {
    local lessons=(welcome orientation stage1_intro stage1_lesson_1 stage1_lesson_2 stage1_lesson_3 stage1_lesson_4)
    local i=0
    while [ "$i" -lt "${#lessons[@]}" ]; do
        panel_at 1 "${lessons[$i]}"
        "${lessons[$i]}"
        local rc=$?
        case "$rc" in
            "$RC_NEXT")  ((i++)) ;;
            "$RC_SHOW")  : ;;
            "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
            "$RC_CHECK")
                # `check` only verifies a gate task; at a lesson it is
                # a no-op. Print a one-line note, pause briefly so the
                # learner can read it, then re-display the lesson via
                # the loop's default (i unchanged).
                printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                sleep 2
                ;;
            *)         return "$rc" ;;
        esac
    done
    PANEL_STAGE=1; PANEL_POS=task
    stage1_gate
}

