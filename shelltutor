    return $?
}

stage3_lesson_2() {
    lesson "$SANDBOX/stage3" <<EOF
${H1}Reading a file${RST}

${CMD}cat${RST} prints a whole file at once.

  ${CMD}cat words.txt${RST}          ${DIM}# the word you put there${RST}
  ${CMD}cat hello.txt${RST}          ${DIM}# nothing: the file is empty${RST}
  ${CMD}cat ../poem.txt${RST}        ${DIM}# the tutor's poem, one folder up${RST}

${INSTR}${G_PLAY} Try all three, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage3_lesson_3() {
    lesson "$SANDBOX/stage3" <<EOF
${H1}Reading a long file${RST}

${CMD}less${RST} shows a long file one screen at a time. While it runs, the
prompt is gone: you are inside a program.

  ${CMD}less ../numbers.txt${RST}    ${DIM}# 50 lines, more than one screen${RST}

${BOLD}Space${RST} pages down, ${BOLD}b${RST} pages back, ${BOLD}q${RST} leaves. ${BOLD}Ctrl+C${RST} does nothing
here; ${BOLD}q${RST} is the way out.

${INSTR}${G_PLAY} Open it, page down, press ${BOLD}q${INSTR}, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage3_lesson_4() {
    lesson "$SANDBOX/stage3" <<EOF
${H1}Copy and move${RST}

${CMD}cp${RST} copies and leaves the original. ${CMD}mv${RST} moves; the same command renames.

  ${CMD}cp hello.txt backup.txt${RST}      ${DIM}# now there are two${RST}
  ${CMD}mv hello.txt hi.txt${RST}          ${DIM}# rename${RST}
  ${CMD}mv hi.txt notes/${RST}             ${DIM}# move into the folder${RST}
  ${CMD}ls -p notes${RST}                  ${DIM}# hi.txt is inside${RST}

${INSTR}${G_PLAY} Try all four, then type ${CMD}next${INSTR}.${RST}
EOF
    return $?
}

stage3_lesson_5() {
