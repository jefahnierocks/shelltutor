}

run_module_shells() {
    PANEL_MODULE=shells
    setup_module_dir shells
    local lessons=(module_shells_intro module_shells_lesson_1 module_shells_lesson_2 module_shells_lesson_3)
    local i rc
    while true; do
        i=0
        while [ "$i" -lt "${#lessons[@]}" ]; do
            PANEL_POS=''
            [ "$i" -ge 1 ] && PANEL_POS="$i of $((${#lessons[@]} - 1))"
            "${lessons[$i]}"
            rc=$?
            case "$rc" in
                "$RC_NEXT")  ((i++)) ;;
                "$RC_SHOW")  : ;;
                "$RC_PREV")  i=$((i > 0 ? i - 1 : 0)) ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to advance or show to redisplay this lesson.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
        module_shells_gate || return $?
        while true; do
            module_shells_cleared
            rc=$?
            case "$rc" in
                "$RC_NEXT")  break ;;
                "$RC_SHOW"|"$RC_PREV") : ;;
                "$RC_CHECK")
                    printf '\n%b(check is only for gate tasks. Type next to start again, or quit to leave.)%b\n' "$DIM" "$RST"
                    sleep 2
                    ;;
                *)           return "$rc" ;;
            esac
        done
    done
}

