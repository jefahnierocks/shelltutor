#!/usr/bin/env bash
# shelltutor — a vimtutor prerequisite course in five mastery-gated stages.
# SPDX-License-Identifier: MIT  — see LICENSE
#
# Usage:
#   shelltutor          resume where you left off
#   shelltutor N        enter stage N (1..5) for re-take or first-time
#   shelltutor -h       this help
#
# Inside lessons, type 'next' at the shelltutor> prompt to advance, 'prev'
# to go back, 'show' to redisplay, 'quit' to leave (progress is saved).
# At a gate task, type 'check' once you have completed the task; the
# script will verify and either pass you or ask you to try again.
#
# Each of the five stages closes with a gate: three recall questions
# (all three must be correct) and one practical task (verified by the
# script). Passing means passing — there is no skip, but there is also
# no time pressure and unlimited retries.
#
# Stage map (vimtutor prerequisite curriculum):
#   1  Where am I?                    echo, pwd, whoami, date, clear, exit
#   2  Paths and the filesystem       ls, cd, .., ~
#   3  Files and operations           touch, mkdir, cat, less, cp, mv, rm
#   4  Commands, streams, composition command -v, |, >, >>, *, wc, seq, ...
#   5  Ready for vimtutor             man, less (full-screen), vim, vimtutor
#
# Implementation invariants:
#   - one bash file, bash 3.2+, no installation, no network, no privilege
#   - tutor writes only inside $SANDBOX (default $HOME/.shelltutor)
#   - practice prompts start in $SANDBOX for stages 1-2 (the Stage 1 gate
#     task in $SANDBOX/stage1) and in $SANDBOX/stageN for stages 3-5
#     (contract C-003); HISTFILE is sandboxed; PS1 is rewritten;
#     navigation builtins are overridden
#   - the practice subshell is a real interactive bash, so the learner
#     retains their normal account authority inside it. The welcome
#     screen scopes the safety claim accordingly (per audit F-002)

set -u

# Bash 5.1+ may buffer here-documents in pipes before their readers start.
# On macOS, reduced pipe capacity can then block this here-doc-heavy script
# before argument dispatch. Compatibility level 5.0 keeps Bash 5.x on the
# temporary-file path; Bash 3.2 treats this as an ordinary variable.
BASH_COMPAT=5.0

# Bash version sanity check. The script uses features present since
# bash 3.2 (arrays, C-style for, here-strings, [[ =~ ]],
# ANSI-C $'\\e[...' quoting). macOS ships bash 3.2 by default and that
# is sufficient — no install step is required to run the tutor. The
# check below only catches truly ancient (bash < 3) systems with a
# clear diagnostic instead of a cryptic syntax error.
if [ "${BASH_VERSINFO[0]:-0}" -lt 3 ]; then
    printf 'shelltutor: requires bash 3.2 or later (found %s).\n' \
        "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# ---------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------

SANDBOX="${SHELLTUTOR_HOME:-$HOME/.shelltutor}"
# A relative SHELLTUTOR_HOME is anchored to the caller's directory once, so
# the sandbox does not move when the practice shell changes folder.
case "$SANDBOX" in
    /*) ;;
    *)  SANDBOX="$PWD/$SANDBOX" ;;
esac
# Trailing slashes would make "$SANDBOX/stage1" differ from what pwd prints.
while [ "${#SANDBOX}" -gt 1 ] && [ "${SANDBOX%/}" != "$SANDBOX" ]; do
    SANDBOX="${SANDBOX%/}"
done
PROGRESS_FILE="$SANDBOX/.progress"
TOTAL_STAGES=5
# Stand-alone modules, entered by name (C-001). Each is one function block
# below (module_<name>_*, run_module_<name>) and writes only under
# $SANDBOX/<name>/; none touches .progress.
MODULES="shells env"

# Exit codes propagated from the practice subshell to the outer dispatcher.
RC_NEXT=0
RC_CHECK=96
RC_SHOW=97
RC_PREV=98
RC_QUIT=99

# ---------------------------------------------------------------------
# ANSI styling. Disabled when stdout isn't a TTY or NO_COLOR is set
# (https://no-color.org).
# ---------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    # Roles per docs/direction-decisions-2026-11.md A3.6. The tutor emits
    # the codes; the learner's terminal chooses the colours.
    H1=$'\e[1;97m'           # screen title
    SUB=$'\e[36m'            # modules only until WP-26: a concept being named
    CMD=$'\e[92m'            # something you can type
    BOLD=$'\e[1m'            # a concept or key being named (A11); replaces SUB/KEY
    NAVW=$'\e[1;90m'         # the navigation words in the footer
    DIR=$'\e[94m'            # modules only until WP-26: a path (plain in the core)
    EM=$'\e[91m'             # a warning; something irreversible
    INSTR=$'\e[93m'          # the action line, header name, feedback bar
    DIM=$'\e[90m'            # asides, footer hints, unreached dots
    OK=$'\e[92m'             # a passed check, a finished stage
    RULE=$'\e[90m'           # box drawing only, never text
    RST=$'\e[0m'
else
    # shellcheck disable=SC1007  # multiple empty assignments on one line are intentional
    BOLD=''; NAVW=''
    H1=''; SUB=''; CMD=''; EM=''; DIR=''; INSTR=''; DIM=''; OK=''; RULE=''; RST=''
fi

# Glyphs (A3.7). ASCII substitutes are chosen by the same plain-text
# condition as the colours (NO_COLOR set, or stdout not a terminal) or by
# an explicit SHELLTUTOR_ASCII=1. Never by locale: the harness runs under
# LC_ALL=C and its sentinels contain the UTF-8 glyphs.
# shellcheck disable=SC2034  # the full glyph set is defined here; not every one is used yet
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${SHELLTUTOR_ASCII:-}" = "1" ]; then
    G_PLAY='>'; G_BOX_OK='[x]'; G_BOX_TODO='[ ]'; G_DONE='#'; G_CUR='*'; G_TODO='-'
    G_BACK='<'; G_DOT_SEP=':'; G_GLOSS_L='('
    G_RULE='-'; G_VBAR='|'; G_BAR='|'
    G_TEE_L='+'; G_BL='+'; G_RTL='+'; G_RTR='+'; G_RBL='+'; G_RBR='+'
    G_TL='+'; G_TR='+'; G_BR='+'
else
    G_PLAY='▶'; G_BOX_OK='[✓]'; G_BOX_TODO='[ ]'; G_DONE='●'; G_CUR='◉'; G_TODO='○'
    G_BACK='◀'; G_DOT_SEP='·'; G_GLOSS_L='('
    G_RULE='─'; G_VBAR='│'; G_BAR='┃'
    G_TEE_L='├'; G_BL='└'; G_RTL='╭'; G_RTR='╮'; G_RBL='╰'; G_RBR='╯'
    G_TL='┌'; G_TR='┐'; G_BR='┘'
fi

# NOTE: do NOT `trap '' INT` here. SIG_IGN propagates across exec, bash
# inherits it, and Ctrl+C breaks inside the practice subshell — silently
# breaking the lessons that teach Ctrl+C. If the user Ctrl+Cs the parent
# script between lessons, the next run auto-resumes from .progress.

# ---------------------------------------------------------------------
# Usage / help
# ---------------------------------------------------------------------

usage() {
    cat <<EOF
shelltutor — a vimtutor prerequisite course (five mastery-gated stages).

Usage:
  shelltutor            resume where you left off
  shelltutor N          enter stage N (1..5) for re-take or first-time
  shelltutor MODULE     run a stand-alone module (see Modules; nothing is saved)
  shelltutor -h         this help
  shelltutor --info     environment check (bash, shell, sandbox, vim, ...)

Stages:
  1  Where am I?
  2  Paths and the filesystem
  3  Files and operations
  4  Commands, streams, composition
  5  Ready for vimtutor

Modules (stand alone; nothing saved):
  shells   What a shell is; other shells; your login shell
  env      Variables, export, PATH and the prompt

Each stage closes with a gate: three recall questions (all three must be
correct) and one practical task (verified by the script). Passing means
passing — unlimited retries, no time pressure, no skip.

Inside the practice prompt:
  next   advance              show   redisplay current screen
  prev   go back              quit   leave (progress is saved)
  check  verify gate task (only at a gate)

Sandbox folder: $SANDBOX
(Override with SHELLTUTOR_HOME=/path ./shelltutor; NO_COLOR disables colour.)
EOF
}

# ---------------------------------------------------------------------
# Preflight
#
# Early-startup checks that catch the most common "this won't work on
# your system" problems before any lesson screen tries to render.
# Silent on success; one-sentence diagnostic + exit 1 on failure.
#
# The checks are intentionally narrow: bash version (already enforced
# at the top of the file), interactive terminal, and writable sandbox.
# Per-command availability (vim, vimtutor, seq, less, ...) is reported
# by --info but is not a hard preflight gate because the lessons that
# need each one handle absence with a fallback or a clear runtime
# message.
# ---------------------------------------------------------------------

preflight() {
    # 1. Interactive terminal. The practice subshell uses
    #    `bash --rcfile /dev/fd/3 -i 3<<RCFILE < /dev/tty`, which only works when
    #    stdin/stdout are a real TTY and /dev/tty is available.
    if [ ! -t 1 ] || [ ! -t 0 ]; then
        printf '%bshelltutor:%b this is an interactive tutor; please run it directly\n' "$EM" "$RST" >&2
        printf 'in a terminal window. stdout or stdin is not a terminal — perhaps the\n' >&2
        printf 'output is being piped, redirected, or the script is running under cron / CI.\n' >&2
        return 1
    fi
    if [ ! -e /dev/tty ]; then
        printf '%bshelltutor:%b /dev/tty is not available; the practice prompts cannot work.\n' "$EM" "$RST" >&2
        printf 'Run the tutor from a normal terminal session, not under a non-interactive service.\n' >&2
        return 1
    fi

    # 2. Writable sandbox.
    if ! mkdir -p "$SANDBOX" 2>/dev/null; then
        printf '%bshelltutor:%b cannot create the sandbox folder at %s%s%s\n' "$EM" "$RST" "$DIR" "$SANDBOX" "$RST" >&2
        printf 'Set SHELLTUTOR_HOME to a writable location, e.g.:\n' >&2
        printf '    %bSHELLTUTOR_HOME=/tmp/shelltutor %s%b\n' "$CMD" "$0" "$RST" >&2
        return 1
    fi
    local writetest="$SANDBOX/.shelltutor_writetest"
    if ! ( : > "$writetest" ) 2>/dev/null; then
        printf '%bshelltutor:%b the sandbox folder exists but is not writable: %s%s%s\n' "$EM" "$RST" "$DIR" "$SANDBOX" "$RST" >&2
        printf 'Set SHELLTUTOR_HOME to a writable location, e.g.:\n' >&2
        printf '    %bSHELLTUTOR_HOME=/tmp/shelltutor %s%b\n' "$CMD" "$0" "$RST" >&2
        return 1
    fi
    rm -f "$writetest" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------
# Diagnostic info (--info)
#
# Prints what the tutor sees about the current environment so a
# beginner can self-diagnose before reading docs. Honest about what's
# OK, what's missing, and what's optional. Exits 0 in all cases —
# this is information, not a gate.
# ---------------------------------------------------------------------

show_info() {
    local ok="${OK}ok${RST}" no="${EM}not ok${RST}" info="${DIM}info${RST}"
    printf '\n%bshelltutor — environment check%b\n\n' "$H1" "$RST"

    # --- bash version
    printf '  %bbash%b         : %s\n' "$SUB" "$RST" "${BASH_VERSION:-unknown}"
    if [ "${BASH_VERSINFO[0]:-0}" -ge 3 ]; then
        printf '                 [%s] requires 3.2+\n' "$ok"
    else
        printf '                 [%s] requires 3.2+; please upgrade bash\n' "$no"
    fi

    # --- login shell (informational)
    printf '  %b$SHELL%b       : %s\n' "$SUB" "$RST" "${SHELL:-(unset)}"
    printf '                 [%s] tutor spawns bash for practice regardless of your login shell\n' "$info"

    # --- sandbox
    printf '  %bSandbox%b      : %s\n' "$SUB" "$RST" "$SANDBOX"
    if [ -d "$SANDBOX" ] && [ -w "$SANDBOX" ]; then
        printf '                 [%s] writable\n' "$ok"
    elif [ -d "$SANDBOX" ]; then
        printf '                 [%s] exists but is not writable — see SHELLTUTOR_HOME override\n' "$no"
    elif [ -w "$(dirname "$SANDBOX")" ] 2>/dev/null; then
        printf '                 [%s] not yet created; will be made on first run\n' "$info"
    else
        printf '                 [%s] parent directory is not writable — see SHELLTUTOR_HOME override\n' "$no"
    fi
    if [ -n "${SHELLTUTOR_HOME:-}" ]; then
        printf '  %b$SHELLTUTOR_HOME%b : %s\n' "$SUB" "$RST" "$SHELLTUTOR_HOME"
    else
        printf '  %b$SHELLTUTOR_HOME%b : %b(unset; default applies)%b\n' "$SUB" "$RST" "$DIM" "$RST"
    fi

    # --- terminal / colour
    printf '  %b$TERM%b        : %s\n' "$SUB" "$RST" "${TERM:-(unset)}"
    if [ -e /dev/tty ]; then
        printf '  %b/dev/tty%b     : available\n' "$SUB" "$RST"
    else
        printf '  %b/dev/tty%b     : %bnot available — practice prompts will fail%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "${NO_COLOR:-}" ]; then
        printf '  %bColour%b       : disabled (NO_COLOR is set)\n' "$SUB" "$RST"
    elif [ -t 1 ]; then
        printf '  %bColour%b       : enabled\n' "$SUB" "$RST"
    else
        printf '  %bColour%b       : disabled (stdout is not a terminal)\n' "$SUB" "$RST"
    fi

    # --- vim / vimtutor (Stage 5 hand-off)
    printf '\n'
    local vim_path vimtutor_path man_path less_path
    vim_path=$(command -v vim 2>/dev/null || true)
    vimtutor_path=$(command -v vimtutor 2>/dev/null || true)
    man_path=$(command -v man 2>/dev/null || true)
    less_path=$(command -v less 2>/dev/null || true)
    if [ -n "$man_path" ]; then
        printf '  %bman%b          : %s\n' "$SUB" "$RST" "$man_path"
    else
        printf '  %bman%b          : %bnot found — the man ls example in lesson 5.1 will not work until it is installed%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$less_path" ]; then
        printf '  %bless%b         : %s\n' "$SUB" "$RST" "$less_path"
    else
        printf '  %bless%b         : %bnot found — the less example in lesson 3.2 will not work until it is installed%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$vim_path" ]; then
        printf '  %bvim%b          : %s\n' "$SUB" "$RST" "$vim_path"
    else
        printf '  %bvim%b          : %bnot found — Stage 5 cannot demo Vim entry/exit until installed%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$vimtutor_path" ]; then
        printf '  %bvimtutor%b     : %s\n' "$SUB" "$RST" "$vimtutor_path"
        printf '                 [%s] the finale names this as the next step\n' "$ok"
    else
        printf '  %bvimtutor%b     : %bnot found%b\n' "$SUB" "$RST" "$DIM" "$RST"
        printf '                 [%s] Stage 5 finale will print install hints instead of handing off\n' "$info"
    fi

    printf '\n%bIf anything above is marked "not ok", see README.md "Run" section.%b\n\n' "$DIM" "$RST"
}

# ---------------------------------------------------------------------
# Sandbox + progress
# ---------------------------------------------------------------------

setup_sandbox() {
    mkdir -p "$SANDBOX"
    # Educational fixtures used by Stage 4. Self-heal if removed.
    if [ ! -f "$SANDBOX/poem.txt" ]; then
        cat > "$SANDBOX/poem.txt" <<'POEM'
The terminal is a quiet room.
You speak to it, it answers back.
Words have shapes here, and shapes have weight.
A pipe is a doorway between rooms.
POEM
    fi
    if [ ! -f "$SANDBOX/numbers.txt" ]; then
        seq 1 50 > "$SANDBOX/numbers.txt"
    fi
    touch "$SANDBOX/.shelltutor_history"
}

setup_stage_dir() {
    local n=$1
    mkdir -p "$SANDBOX/stage${n}"
    case "$n" in
        4)  # Stage 4 lessons count lines in poem.txt from inside the
            # stage folder; seed.txt gives the *.txt glob a second match.
            [ -f "$SANDBOX/stage4/poem.txt" ] \
                || cp "$SANDBOX/poem.txt" "$SANDBOX/stage4/poem.txt"
            if [ ! -f "$SANDBOX/stage4/seed.txt" ]; then
                cat > "$SANDBOX/stage4/seed.txt" <<'EOF_SEED'
a small text file
to give the glob something to match
EOF_SEED
            fi
            ;;
        5)  # Lesson 5.4 edits practice.txt; the gate re-seeds it to
            # exactly 'before' at gate entry (stage5_seed_practice).
            [ -f "$SANDBOX/stage5/practice.txt" ] \
                || echo before > "$SANDBOX/stage5/practice.txt"
            ;;
    esac
}

# Module fixtures (C-003): $SANDBOX/<name>/, created on entry and
# self-healing like the stage folders. `shells` and `env` seed nothing; each gate
# clears its own output file.
setup_module_dir() {
    mkdir -p "$SANDBOX/$1"
}

save_progress() {
    # Only advance, never regress. .progress = number of stages passed.
    local cur
    cur=$(read_progress)
    if [ "$1" -gt "$cur" ]; then
        echo "$1" > "$PROGRESS_FILE" 2>/dev/null || true
    fi
}

read_progress() {
    local n=0
    if [ -f "$PROGRESS_FILE" ]; then
        read -r n < "$PROGRESS_FILE" 2>/dev/null || n=0
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        # Defensive clamp. A pre-curriculum-redesign sandbox may carry
        # a .progress value in the old "next lesson index" semantics
        # (0..9). Anything above TOTAL_STAGES is treated as stale and
        # reset to 0 so the learner re-enters at Stage 1 rather than
        # being skipped to the finale.
        if [ "$n" -gt "$TOTAL_STAGES" ]; then n=0; fi
    fi
    echo "$n"
}

# ---------------------------------------------------------------------
# Panel chrome (A3.1-A3.3)
#
# Every tutor screen is a panel between two rules; the practice prompt
# beneath it is the real shell. The runners set PANEL_STAGE (1-5, or empty
# before Stage 1 and on the cleared screen) and PANEL_POS ("1.1", "task",
# or empty) before each screen. Fixed 80 columns: no tput, no COLUMNS.
# Rules are built by a loop: tr on a multibyte glyph and ${s:0:n} both
# count bytes under LC_ALL=C. The title strings are ASCII, so ${#var}
# is a column count; the glyph widths are added as constants.
# ---------------------------------------------------------------------

PANEL_STAGE=''
PANEL_POS=''
PANEL_DONE=''
PANEL_MODULE=''
PANEL_COLS=80
# Panel rows (header through lower rule): the budget is 19 (A11, enforced by the
# harness); lessons may run to this hard cap of 21 until WP-26 cuts them.
PANEL_HARD_CAP=21

# panel_rule N  -> sets REPLY to N rule glyphs.
panel_rule() {
    local i s=''
    for ((i = 0; i < $1; i++)); do s="$s$G_RULE"; done
    REPLY="$s"
}

panel_title() {
    case "$1" in
        1) REPLY='Where am I?' ;;
        2) REPLY='Paths' ;;
        3) REPLY='Files' ;;
        4) REPLY='Commands and streams' ;;
        5) REPLY='Ready for vimtutor' ;;
        *) REPLY='' ;;
    esac
}

# panel_at STAGE LESSON_FUNCTION: set the globals for the next screen.
panel_at() {
    PANEL_STAGE=$1
    PANEL_POS=''
    PANEL_DONE=''
    case "$2" in
        welcome|orientation) PANEL_STAGE='' ;;
        stage[1-5]_lesson_[1-9]) PANEL_POS="$1.${2##*_}" ;;
    esac
}

# panel_header (A11 C2): "── Stage N · <title> ──…── ●◉○○○  N.k ──", two rule
# glyphs at each end, 80 columns. The product name leads only where the
# learner pauses (welcome, orientation, stage intro, cleared): a screen with
# no position. A cleared screen has no current dot; its done count is
# PANEL_DONE. A module has no dots: "── Module · name ──…── 2 of 4 ──".
panel_header() {
    local prog i title='' lead tail dots='' n used cleared='' show_name=''
    prog=$(read_progress)
    [ -z "$PANEL_POS" ] && show_name=1
    lead="${RULE}${G_RULE}${G_RULE}${RST} "
    used=3
    if [ -n "$show_name" ]; then
        lead="${lead}${INSTR}shelltutor${RST} ${RULE}${G_RULE}${G_RULE}${RST} "
        used=$((used + 14))
    fi
    if [ -n "$PANEL_MODULE" ]; then
        lead="${lead}${DIM}Module ${G_DOT_SEP} ${PANEL_MODULE}${RST} "
        used=$((used + 10 + ${#PANEL_MODULE}))
        if [ -n "$PANEL_POS" ]; then
            tail=" ${INSTR}${PANEL_POS}${RST} ${RULE}${G_RULE}${G_RULE}${RST}"
            n=$((PANEL_COLS - used - 4 - ${#PANEL_POS}))
        else
            tail=" ${RULE}${G_RULE}${G_RULE}${RST}"
            n=$((PANEL_COLS - used - 3))
        fi
        [ "$n" -ge 1 ] || n=1
        panel_rule "$n"
        printf '%s%s%s%s%s\n' "$lead" "$RULE" "$REPLY" "$RST" "$tail"
        return 0
    fi
    if [ -z "$PANEL_STAGE" ] && [ -n "$PANEL_DONE" ]; then
        cleared=1
        panel_title "$PANEL_DONE"
        title="$REPLY"
        lead="${lead}${DIM}Stage ${PANEL_DONE} ${G_DOT_SEP} ${title}${RST} "
        used=$((used + 11 + ${#title}))
    elif [ -n "$PANEL_STAGE" ]; then
        panel_title "$PANEL_STAGE"
        title="$REPLY"
        lead="${lead}${DIM}Stage ${PANEL_STAGE} ${G_DOT_SEP} ${title}${RST} "
        used=$((used + 11 + ${#title}))
    fi
    for ((i = 1; i <= 5; i++)); do
        if [ -n "$cleared" ]; then
            if [ "$i" -le "$PANEL_DONE" ]; then
                dots="${dots}${OK}${G_DONE}${RST}"
            else
                dots="${dots}${DIM}${G_TODO}${RST}"
            fi
        elif [ "$i" = "$PANEL_STAGE" ]; then
            dots="${dots}${INSTR}${G_CUR}${RST}"
        elif [ "$i" -le "$prog" ]; then
            dots="${dots}${OK}${G_DONE}${RST}"
        else
            dots="${dots}${DIM}${G_TODO}${RST}"
        fi
    done
    if [ -n "$PANEL_POS" ]; then
        # " <5 dots>  <pos> ──" is 11 columns plus the position.
        tail=" ${dots}  ${INSTR}${PANEL_POS}${RST} ${RULE}${G_RULE}${G_RULE}${RST}"
        n=$((PANEL_COLS - used - 11 - ${#PANEL_POS}))
    else
        # " <5 dots> ──" is 9 columns.
        tail=" ${dots} ${RULE}${G_RULE}${G_RULE}${RST}"
        n=$((PANEL_COLS - used - 9))
    fi
    [ "$n" -ge 1 ] || n=1
    panel_rule "$n"
    printf '%s%s%s%s%s\n' "$lead" "$RULE" "$REPLY" "$RST" "$tail"
}

panel_lower_rule() {
    panel_rule "$PANEL_COLS"
    printf '%s%s%s\n' "$RULE" "$REPLY" "$RST"
}

# footer_item VERB [GLOSS] -> "verb (gloss)", the verb in NAVW (bold grey),
# the gloss DIM; the gloss is left out when empty (A11 C3).
footer_item() {
    if [ -n "${2:-}" ]; then
        printf '%s%s%s %s%s%s%s%s' "$NAVW" "$1" "$RST" "$DIM" "$G_GLOSS_L" "$2" ")" "$RST"
    else
        printf '%s%s%s' "$NAVW" "$1" "$RST"
    fi
}

# footer_bar MODE [STAGE]: one row, the mode's verb first (A3.3, A11). Glosses
# through Stage 1, in modules and on cleared screens; words only from Stage 2.
# The gate's recall and task phases have their own forms. STAGE is the
# panel's stage (empty on cleared screens and in modules).
footer_bar() {
    local g1="${2:-}" g_next g_show g_prev g_quit
    case "$1" in
        recall)
            printf '%s   %s' \
                "$(footer_item show 'the question again')" \
                "$(footer_item quit 'save and leave')"
            ;;
        gate)
            printf '%s   %s   %s' \
                "$(footer_item check 'test your work')" \
                "$(footer_item show 'the task again')" \
                "$(footer_item quit 'save and leave')"
            ;;
        module-cleared)
            printf '%s   %s   %s' \
                "$(footer_item next 'start this module again')" \
                "$(footer_item quit 'leave')" \
                "$(footer_item show 'this screen again')"
            ;;
        cleared)
            printf '%s   %s   %s' \
                "$(footer_item next "Stage $((${PANEL_DONE:-0} + 1))")" \
                "$(footer_item quit 'stop here, place saved')" \
                "$(footer_item show 'this screen again')"
            ;;
        *)
            if [ -z "$g1" ] || [ "$g1" = 1 ] || [ -n "$PANEL_MODULE" ]; then
                g_next='go on'; g_show='this screen again'; g_prev='back'; g_quit='save and leave'
            else
                g_next=''; g_show=''; g_prev=''; g_quit=''
            fi
            printf '%s   %s   %s   %s' \
                "$(footer_item next "$g_next")" \
                "$(footer_item show "$g_show")" \
                "$(footer_item prev "$g_prev")" \
                "$(footer_item quit "$g_quit")"
            ;;
    esac
}

# ---------------------------------------------------------------------
# Practice subshell
#
# Spawns a real interactive bash with a sandboxed HISTFILE and PS1, in
# the requested working directory (defaults to $SANDBOX). The rcfile
# overrides five builtins so that the learner's navigation words exit
# with codes the outer dispatcher interprets:
#   next  -> 0   check -> 96   show -> 97   prev -> 98   quit/exit -> 99
# ---------------------------------------------------------------------

# The one farewell: used by the practice prompt's quit and by quit at a
# recall question, so the text is a single string (C-006).
farewell_exit() {
    clear 2>/dev/null || true
    if [ -n "$PANEL_MODULE" ]; then
        echo "Bye. A module saves nothing; run 'shelltutor $PANEL_MODULE' to start it again."
    else
        echo "Bye. Run 'shelltutor' again to pick up where you left off."
    fi
    exit 0
}

practice() {
    local pd="${1:-$SANDBOX}"
    setup_sandbox
    mkdir -p "$pd"

    # The footer is part of the panel now (show_screen prints it above the
    # lower rule, A11): the shell zone below the rule holds only the prompt.

    # Feed the rcfile on fd 3 instead of process substitution. macOS Bash
    # 3.2 can parse <(...) here but does not reliably load it as --rcfile.
    # INPUTRC=/dev/null keeps Readline on its defaults so the practice
    # prompt behaves the same on every host (contract C-007).
    # The practice shell is the same binary as the outer script ($BASH),
    # never whatever `bash` happens to be first on PATH (F-014).
    # BASH_SILENCE_DEPRECATION_WARNING=1 stops Apple's /bin/bash 3.2 from
    # printing a four-row "default shell is now zsh" notice before the
    # first prompt (F-016). Apple's bash checks the variable after the
    # rcfile has run, so the rcfile must not unset it.
    INPUTRC=/dev/null BASH_SILENCE_DEPRECATION_WARNING=1 "$BASH" --rcfile /dev/fd/3 -i 3<<RCFILE < /dev/tty
# shelltutor practice shell — contract C-007 in docs/contracts.md.
# No system or user rcfile is sourced by this file. Distributions that compile Bash
# with a system rcfile still read it before this file; the settings
# below override what matters to the lessons.

# Inherited variables that would change what the lessons show or record.
unset -v CDPATH GLOBIGNORE HISTIGNORE HISTCONTROL HISTTIMEFORMAT TMOUT BASH_ENV
unset -v PROMPT_COMMAND
# Distribution hook that advertises package installs for unknown commands.
unset -f command_not_found_handle

set -o emacs
shopt -s histappend
shopt -u cdspell

cd "$pd"

HISTFILE="$SANDBOX/.shelltutor_history"
HISTSIZE=2000
HISTFILESIZE=4000
history -r 2>/dev/null || true
PROMPT_COMMAND='history -a'

PS1='shelltutor> '
PS2='> '

# Readline: common-Bash completion behaviour, no bell (see lesson 1.2).
bind 'set show-all-if-ambiguous off'
bind 'set show-all-if-unmodified off'
bind 'set completion-ignore-case off'
bind 'set bell-style none'

# Navigation builtins: functions, not aliases, so alias chains can't
# recurse. \`exec >/dev/null 2>&1\` immediately before \`builtin exit\`
# suppresses bash's "exit\n" interactive-logout print (which beginners
# read as a separate command being run); the subshell then exits with
# the navigation code the outer dispatcher interprets.
next()  { exec >/dev/null 2>&1; builtin exit  0; }
check() { exec >/dev/null 2>&1; builtin exit 96; }
prev()  { exec >/dev/null 2>&1; builtin exit 98; }
show()  { exec >/dev/null 2>&1; builtin exit 97; }
quit()  { exec >/dev/null 2>&1; builtin exit 99; }
exit()  { exec >/dev/null 2>&1; builtin exit 99; }
RCFILE
    local code=$?
    if [ "$code" -eq $RC_QUIT ]; then
        farewell_exit
    fi
    return "$code"
}

# ---------------------------------------------------------------------
# Lesson screen helper
# ---------------------------------------------------------------------

# show_screen [MODE]: header, blank, body, blank, the ▶ line, blank, footer,
# lower rule, blank (A11 C1). MODE picks the footer (lesson by default; also
# recall, gate, cleared, module-cleared). The ▶ line is the body's last
# paragraph; it always has exactly one blank row above and below it.
show_screen() {
    local mode="${1:-lesson}" body para rest
    body=$(cat)
    clear 2>/dev/null || printf '\n'
    panel_header
    printf '\n'
    para=${body##*$'\n\n'}
    case "$para" in
        "${INSTR}${G_PLAY}"*) rest=${body%"$para"} ;;
        *)
            para=${body##*$'\n'}
            case "$para" in
                "${INSTR}${G_PLAY}"*) rest=${body%"$para"} ;;
                *) para=''; rest=$body ;;
            esac
            ;;
    esac
    while [ "${rest%$'\n'}" != "$rest" ]; do rest=${rest%$'\n'}; done
    # Interim squeeze (WP-25, until WP-26 cuts the bodies): the panel may not
    # pass PANEL_HARD_CAP rows, so interior blank rows go from the bottom up,
    # never the one under the title. Words are never touched.
    local rows blanks_before
    rows=$(printf '%s\n%s\n' "$rest" "$para" | wc -l)
    while [ $((rows + 6)) -gt "$PANEL_HARD_CAP" ]; do
        blanks_before=${rest%$'\n\n'*}
        [ "$blanks_before" != "$rest" ] || break
        case "$blanks_before" in *$'\n\n'*) ;; *) break ;; esac
        rest="$blanks_before"$'\n'"${rest##*$'\n\n'}"
        rows=$((rows - 1))
    done
    if [ -n "$para" ]; then
        printf '%s\n\n%s\n\n' "$rest" "$para"
    else
        printf '%s\n\n' "$rest"
    fi
    printf '%s\n' "$(footer_bar "$mode" "$PANEL_STAGE")"
    panel_lower_rule
    printf '\n'
}

# Optional directory argument: the practice prompt starts there. Stages 1
# and 2 use the SANDBOX default; stage 3 to 5 lessons pass their stage folder.
# shellcheck disable=SC2120
lesson() {
    show_screen
    practice "${1:-$SANDBOX}"
    return $?
}

# ---------------------------------------------------------------------
# Recall-question helper
#
# Usage: ask_question "<prompt>" "<hint>" <exact-form>... [-- <group>...]
#   One argument per source line; scripts/check-hints.sh (FF-009) relies on it.
# - Reads input from /dev/tty so it works inside the parent shell.
# - Normalizes by lowercasing + trimming whitespace.
# - Accepts the answer (A10) when EITHER it equals a normalized exact form,
#   OR it holds no negation word AND, for every keyword group, at least one
#   of the group's |-separated phrases appears in it as whole words. Loops
#   until correct. See recall_matches.
# - Ladder (A7, replacing A1.1): miss 1 the message plus the hint; miss 2 and
#   later the hint plus the three navigation facts (A1.6); the A8 shape line
#   was removed again by A10. Recall only; the task ladder keeps its three
#   rungs. Never a reveal.
# - `show` repeats the question without counting a miss; `quit` or `exit`
#   leaves with the farewell (passed stages are already saved).
# - Returns 0 on correct answer.
# ---------------------------------------------------------------------

# Lower-case, delete apostrophes (' and the typographic one, so "I'm" matches
# the im forms), commas, periods, exclamation marks, parentheses and
# semicolons (not colons, so :w and :q! survive), collapse any run of whitespace to one space, trim the ends.
# tr -s is POSIX; GNU sed's \+ is not (audit/2026-11-07/findings.md F-012).
# The typographic apostrophe (U+2019) is multibyte, so it goes through sed
# as its UTF-8 byte sequence, not through tr.
# normalize_lines does the work one line at a time (stdin to stdout), so a
# whole list of forms goes through one pipeline instead of one per form.
normalize_lines() {
    tr '[:upper:]' '[:lower:]' | tr -d "'.,!();" \
        | sed "s/$(printf '\342\200\231')//g; s/[[:space:]][[:space:]]*/ /g; s/^ //; s/ \$//"
}

normalize_answer() {
    printf '%s' "$1" | normalize_lines
}

# Words that void a keyword match (A10; C-006). A fixed list, one place.
# Questions whose right answer is itself a negation (Stage 3 Q2, Stage 5 Q3)
# rely on their exact forms, which this guard never touches.
RECALL_NEGATIONS='not no never nowhere nothing none isnt doesnt dont wont cant without instead rather neither nor only'

# recall_matches NORM EXACT... [-- [--ordered] GROUP... [--reject PHRASES]]:
# succeed when NORM (already normalised) equals a normalised exact form, or
# holds no negation word, none of the |-separated --reject phrases, and hits
# every GROUP (a |-separated list of phrases, whole-word containment). With
# --ordered each group's match must come after the previous group's match.
# Whole words: both sides are padded with spaces. Bash 3.2: no arrays of
# arrays, no empty-array expansion under set -u.
recall_matches() {
    local norm="$1" a w g phrase ok_norm padded
    shift
    local groups=() exacts=() seen_sep=0 ordered=0 rejects="" take_rej=0
    local pos=0 sub best cand blen pre
    for a in "$@"; do
        if [ "$take_rej" -eq 1 ]; then
            rejects=$a; take_rej=0; continue
        fi
        if [ "$seen_sep" -eq 0 ] && [ "$a" = "--" ]; then
            seen_sep=1; continue
        fi
        if [ "$seen_sep" -eq 0 ]; then
            exacts+=("$a")
        elif [ "$a" = "--ordered" ]; then
            ordered=1
        elif [ "$a" = "--reject" ]; then
            take_rej=1
        else
            groups+=("$a")
        fi
    done
    # One pipeline for all exact forms, one more per group.
    while IFS= read -r ok_norm; do
        if [ "$norm" = "$ok_norm" ]; then
            return 0
        fi
    done <<EXACTS
$(printf '%s\n' "${exacts[@]}" | normalize_lines)
EXACTS
    [ "${#groups[@]}" -gt 0 ] || return 1
    padded=" $norm "
    for w in $RECALL_NEGATIONS; do
        case "$padded" in *" $w "*) return 1 ;; esac
    done
    while IFS= read -r phrase; do
        [ -n "$phrase" ] || continue
        case "$padded" in *" $phrase "*) return 1 ;; esac
    done <<REJECTS
$(printf '%s\n' "$rejects" | tr '|' '\n' | normalize_lines)
REJECTS
    for g in "${groups[@]}"; do
        best=-1; sub=${padded:pos}
        while IFS= read -r phrase; do
            [ -n "$phrase" ] || continue
            case "$sub" in
                *" $phrase "*)
                    pre=${sub%%" $phrase "*}; cand=${#pre}
                    if [ "$best" -lt 0 ] || [ "$cand" -lt "$best" ]; then
                        best=$cand; blen=${#phrase}
                    fi ;;
            esac
        done <<PHRASES
$(printf '%s\n' "$g" | tr '|' '\n' | normalize_lines)
PHRASES
        [ "$best" -ge 0 ] || return 1
        # Ordered groups: the next group is searched after this match.
        [ "$ordered" -eq 1 ] && pos=$((pos + best + blen + 1))
    done
    return 0
}

# The three navigation facts (A1.6), in the feedback bar. Wording is not
# contractual (C-006); the facts and their order are.
recall_navigation() {
    fb_note "Passed stages are saved."
    fb_note "Type ${CMD}quit${RST} to leave now; the next run starts this stage from its first lesson."
    fb_note "Type ${CMD}show${RST} to see the question again."
}

# recall_say TEXT: one bar row, the tutor speaking.
recall_say() { fb_note "$1"; }

# recall_bar_blank: a bar row with nothing after it.
recall_bar_blank() { printf '%s%s%s\n' "$INSTR" "$G_BAR" "$RST"; }

# recall_show_question PROMPT (A11 C6): "┃ 1 of 3   <question>" wrapped at
# 76 columns under the bar, any trailing "(a, b, c)" options on their own
# row, then a bar-only row. PROMPT starts "Qn: ". The text is wrapped by
# awk, which strips the colour codes when it measures a word.
recall_show_question() {
    local prompt="$1" n text opts='' line first=1
    n=${prompt%%:*}; n=${n#Q}
    text=${prompt#*: }
    case "$text" in
        *")")
            opts=${text##* (}
            if [ "$opts" != "$text" ]; then
                text=${text% (*}
                text=${text%" "}
                opts=${opts%)}
            else
                opts=''
            fi
            ;;
    esac
    while IFS= read -r line; do
        if [ "$first" = 1 ]; then
            printf '%s%s%s %s of 3   %s\n' "$INSTR" "$G_BAR" "$RST" "$n" "$line"
            first=0
        else
            printf '%s%s%s          %s\n' "$INSTR" "$G_BAR" "$RST" "$line"
        fi
    done <<WRAP
$(printf '%s\n' "$text" | awk -v w=65 '
    {
        nw = split($0, words, " "); line = ""; len = 0
        for (i = 1; i <= nw; i++) {
            v = words[i]; gsub(/\033\[[0-9;]*m/, "", v); vl = length(v)
            if (len > 0 && len + 1 + vl > w) { print line; line = words[i]; len = vl }
            else { line = (len > 0 ? line " " : "") words[i]; len += (len > 0 ? 1 : 0) + vl }
        }
        print line
    }')
WRAP
    if [ -n "$opts" ]; then
        printf '%s%s%s          %s\n' "$INSTR" "$G_BAR" "$RST" \
            "$(printf '%s\n' "$opts" | awk -F',' '{
                for (i = 1; i <= NF; i++) {
                    g = $i; sub(/^ +/, "", g); sub(/ +$/, "", g); sub(/^or /, "", g)
                    out = out (i > 1 ? "    " : "") g
                }
                print out }')"
    fi
    recall_bar_blank
}

# recall_prompt: the input row, "┃ ? ".
recall_prompt() {
    printf '%s%s ?%s ' "$INSTR" "$G_BAR" "$RST"
}

ask_question() {
    local prompt="$1" hint="$2"; shift 2
    local accept=("$@")
    local ans norm attempt=0
    recall_show_question "$prompt"
    while true; do
        recall_prompt
        if ! IFS= read -r ans < /dev/tty; then
            printf '\n'
            return 1
        fi
        norm=$(normalize_answer "$ans")
        case "$norm" in
            show) recall_show_question "$prompt"; continue ;;
            quit|exit) farewell_exit ;;
        esac
        if recall_matches "$norm" "${accept[@]}"; then
            printf '%s%s%s %s%s%s\n\n' "$INSTR" "$G_BAR" "$RST" "$OK" "$G_BOX_OK" "$RST"
            return 0
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 2 ]; then
            fb_note "${EM}not quite.${RST} ${DIM}hint:${RST} $hint"
            recall_navigation
        else
            fb_note "${EM}not quite.${RST} try again."
        fi
    done
}

# ---------------------------------------------------------------------
# History helpers
# ---------------------------------------------------------------------

# Marks the current size of HISTFILE; later, history_since_marker shows
# only lines added since.
history_mark() {
    [ -f "$SANDBOX/.shelltutor_history" ] || touch "$SANDBOX/.shelltutor_history"
    wc -l < "$SANDBOX/.shelltutor_history" 2>/dev/null | tr -d '[:space:]'
}

history_since() {
    local mark=$1
    local total
    total=$(wc -l < "$SANDBOX/.shelltutor_history" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$total" ] || [ "$total" -le "$mark" ]; then
        return 0
    fi
    tail -n "$((total - mark))" "$SANDBOX/.shelltutor_history"
}

# ---------------------------------------------------------------------
# Gate feedback (A3.4): a checklist inside a bar. Every line of the block
# starts with the bar in INSTR. fb_ok marks what the gate saw done, fb_todo
# what it did not, with "not yet: <what it sees instead>". Wording is not
# contractual (C-006); the shape is.
# ---------------------------------------------------------------------

fb_begin() { printf '\n'; }

# fb_note TEXT  -> "┃ TEXT"
fb_note() {
    printf '%s%s%s %s\n' "$INSTR" "$G_BAR" "$RST" "$1"
}

# fb_ok LABEL  -> "┃ [✓] LABEL"
fb_ok() {
    printf '%s%s%s %s%s%s %s\n' "$INSTR" "$G_BAR" "$RST" "$OK" "$G_BOX_OK" "$RST" "$1"
}

# fb_todo LABEL SEEN  -> "┃ [ ] LABEL      seen: SEEN". The reason is what the
# gate observed, never an instruction (A11 C7); the instruction is the hint
# rung's job.
fb_todo() {
    printf '%s%s%s %s%s%s %-30s %sseen: %s%s\n' "$INSTR" "$G_BAR" "$RST" \
        "$DIM" "$G_BOX_TODO" "$RST" "$1" "$DIM" "$2" "$RST"
}

# fb_close  -> the standard closing line of a checklist.
fb_close() {
    fb_note "Finish the step marked ${G_BOX_TODO}, then type ${CMD}check${RST} again."
}

# gate_require_history MARK LABEL ERE [LABEL ERE ...]
# Looks at the practice-shell commands recorded since MARK (a history_mark
# value). Each ERE is matched with grep -E against the recorded lines.
# Prints a checklist (ticked for seen, "not yet" for missing) and returns 1
# when any LABEL's ERE never matched; prints nothing and returns 0 when
# everything was seen.
gate_require_history() {
    local mark="$1"; shift
    local recent label pattern
    local labels=() seen=() missing=0
    recent=$(history_since "$mark")
    while [ "$#" -ge 2 ]; do
        label="$1"; pattern="$2"; shift 2
        labels+=("$label")
        if printf '%s\n' "$recent" | grep -qE "$pattern"; then
            seen+=(1)
        else
            seen+=(0); missing=$((missing + 1))
        fi
    done
    # Return before expanding "${labels[@]}": on Bash 3.2 an empty array
    # expansion is an unbound-variable error under set -u.
    [ "$missing" -eq 0 ] && return 0
    local i=0
    fb_begin
    for label in "${labels[@]}"; do
        if [ "${seen[$i]}" = 1 ]; then
            fb_ok "$label"
        else
            fb_todo "$label" "none typed since the task began"
        fi
        i=$((i + 1))
    done
    fb_close
    return 1
}

# gate_escalate ATTEMPT HINT EXAMPLE...
# attempt 1: nothing extra (the gate already printed what it saw).
# attempt 2: HINT. attempt 3+: HINT plus the worked EXAMPLE lines, which
# the learner still has to type themselves. There is no auto-pass. The
# hint and example continue the feedback bar; a blank line ends the block.
gate_escalate() {
    local attempt="$1" hint="$2"; shift 2
    if [ "$attempt" -ge 2 ]; then
        fb_note "${SUB}Hint:${RST} $hint"
        if [ "$attempt" -ge 3 ] && [ "$#" -gt 0 ]; then
            fb_note "${SUB}Worked example — type these yourself:${RST}"
            local line
            for line in "$@"; do
                fb_note "  ${CMD}${line}${RST}"
            done
        fi
    fi
    printf '\n'
}

