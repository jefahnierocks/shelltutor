#!/usr/bin/env bash
# shelltutor — a vimtutor prerequisite course in five mastery-gated stages.
# SPDX-License-Identifier: MIT  — see LICENSE
#
# Usage:
#   shelltutor          resume where you left off
#   shelltutor N        enter stage N (1..5) for re-take or first-time
#   shelltutor -h       this help
#
# Inside lessons, type 'next' at the shelltutor> prompt to advance, 'prev'
# to go back, 'show' to redisplay, 'quit' to leave (progress is saved).
# At a gate task, type 'check' once you have completed the task; the
# script will verify and either pass you or ask you to try again.
#
# Each of the five stages closes with a gate: three recall questions
# (all three must be correct) and one practical task (verified by the
# script). Passing means passing — there is no skip, but there is also
# no time pressure and unlimited retries.
#
# Stage map (vimtutor prerequisite curriculum):
#   1  Where am I?                    echo, pwd, whoami, date, clear, exit
#   2  Paths and the filesystem       ls, cd, .., ~
#   3  Files and operations           touch, mkdir, cat, less, cp, mv, rm
#   4  Commands, streams, composition command -v, |, >, >>, *, wc, seq, ...
#   5  Ready for vimtutor             man, less (full-screen), vim, vimtutor
#
# Implementation invariants:
#   - one bash file, bash 3.2+, no installation, no network, no privilege
#   - tutor writes only inside $SANDBOX (default $HOME/.shelltutor)
#   - practice prompts start in $SANDBOX for stages 1-2 (the Stage 1 gate
#     task in $SANDBOX/stage1) and in $SANDBOX/stageN for stages 3-5
#     (contract C-003); HISTFILE is sandboxed; PS1 is rewritten;
#     navigation builtins are overridden
#   - the practice subshell is a real interactive bash, so the learner
#     retains their normal account authority inside it. The welcome
#     screen scopes the safety claim accordingly (per audit F-002)

set -u

# Bash 5.1+ may buffer here-documents in pipes before their readers start.
# On macOS, reduced pipe capacity can then block this here-doc-heavy script
# before argument dispatch. Compatibility level 5.0 keeps Bash 5.x on the
# temporary-file path; Bash 3.2 treats this as an ordinary variable.
BASH_COMPAT=5.0

# Bash version sanity check. The script uses features present since
# bash 3.2 (arrays, C-style for, here-strings, [[ =~ ]],
# ANSI-C $'\\e[...' quoting). macOS ships bash 3.2 by default and that
# is sufficient — no install step is required to run the tutor. The
# check below only catches truly ancient (bash < 3) systems with a
# clear diagnostic instead of a cryptic syntax error.
if [ "${BASH_VERSINFO[0]:-0}" -lt 3 ]; then
    printf 'shelltutor: requires bash 3.2 or later (found %s).\n' \
        "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# ---------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------

SANDBOX="${SHELLTUTOR_HOME:-$HOME/.shelltutor}"
# A relative SHELLTUTOR_HOME is anchored to the caller's directory once, so
# the sandbox does not move when the practice shell changes folder.
case "$SANDBOX" in
    /*) ;;
    *)  SANDBOX="$PWD/$SANDBOX" ;;
esac
# Trailing slashes would make "$SANDBOX/stage1" differ from what pwd prints.
while [ "${#SANDBOX}" -gt 1 ] && [ "${SANDBOX%/}" != "$SANDBOX" ]; do
    SANDBOX="${SANDBOX%/}"
done
PROGRESS_FILE="$SANDBOX/.progress"
TOTAL_STAGES=5

# Exit codes propagated from the practice subshell to the outer dispatcher.
RC_NEXT=0
RC_CHECK=96
RC_SHOW=97
RC_PREV=98
RC_QUIT=99

# ---------------------------------------------------------------------
# ANSI styling. Disabled when stdout isn't a TTY or NO_COLOR is set
# (https://no-color.org).
# ---------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    # Roles per docs/direction-decisions-2026-11.md A3.6. The tutor emits
    # the codes; the learner's terminal chooses the colours.
    H1=$'\e[1;97m'           # screen title
    SUB=$'\e[36m'            # a concept being named
    CMD=$'\e[92m'            # something you can type
    KEY=$'\e[95m'            # a key or chord; the navigation words
    DIR=$'\e[94m'            # a path or folder
    EM=$'\e[91m'             # a warning; something irreversible
    INSTR=$'\e[93m'          # the action line, header name, feedback bar
    DIM=$'\e[90m'            # asides, footer hints, unreached dots
    OK=$'\e[92m'             # a passed check, a finished stage
    Q=$'\e[96m'              # a recall question
    RULE=$'\e[90m'           # box drawing only, never text
    RST=$'\e[0m'
else
    # shellcheck disable=SC1007  # multiple empty assignments on one line are intentional
    H1=''; SUB=''; CMD=''; KEY=''; EM=''; DIR=''; INSTR=''; DIM=''; OK=''; Q=''; RULE=''; RST=''
fi

# Glyphs (A3.7). ASCII substitutes are chosen by the same plain-text
# condition as the colours (NO_COLOR set, or stdout not a terminal) or by
# an explicit SHELLTUTOR_ASCII=1. Never by locale: the harness runs under
# LC_ALL=C and its sentinels contain the UTF-8 glyphs.
# shellcheck disable=SC2034  # the full glyph set is defined here; not every one is used yet
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${SHELLTUTOR_ASCII:-}" = "1" ]; then
    G_PLAY='>'; G_OK='ok'; G_DONE='#'; G_CUR='*'; G_TODO='-'
    G_HINT='>'; G_BACK='<'; G_SEP='-'
    G_RULE='-'; G_VBAR='|'; G_BAR='|'
    G_TEE_L='+'; G_BL='+'; G_RTL='+'; G_RTR='+'; G_RBL='+'; G_RBR='+'
    G_TL='+'; G_TR='+'; G_BR='+'
else
    G_PLAY='▶'; G_OK='✓'; G_DONE='●'; G_CUR='◉'; G_TODO='○'
    G_HINT='▸'; G_BACK='◀'; G_SEP='·'
    G_RULE='─'; G_VBAR='│'; G_BAR='┃'
    G_TEE_L='├'; G_BL='└'; G_RTL='╭'; G_RTR='╮'; G_RBL='╰'; G_RBR='╯'
    G_TL='┌'; G_TR='┐'; G_BR='┘'
fi

# NOTE: do NOT `trap '' INT` here. SIG_IGN propagates across exec, bash
# inherits it, and Ctrl+C breaks inside the practice subshell — silently
# breaking the lessons that teach Ctrl+C. If the user Ctrl+Cs the parent
# script between lessons, the next run auto-resumes from .progress.

# ---------------------------------------------------------------------
# Usage / help
# ---------------------------------------------------------------------

usage() {
    cat <<EOF
shelltutor — a vimtutor prerequisite course (five mastery-gated stages).

Usage:
  shelltutor            resume where you left off
  shelltutor N          enter stage N (1..5) for re-take or first-time
  shelltutor -h         this help
  shelltutor --info     environment check (bash, shell, sandbox, vim, ...)

Stages:
  1  Where am I?
  2  Paths and the filesystem
  3  Files and operations
  4  Commands, streams, composition
  5  Ready for vimtutor

Each stage closes with a gate: three recall questions (all three must be
correct) and one practical task (verified by the script). Passing means
passing — unlimited retries, no time pressure, no skip.

Inside the practice prompt:
  next   advance              show   redisplay current screen
  prev   go back              quit   leave (progress is saved)
  check  verify gate task (only at a gate)

Sandbox folder: $SANDBOX
(Override with SHELLTUTOR_HOME=/path ./shelltutor; NO_COLOR disables colour.)
EOF
}

# ---------------------------------------------------------------------
# Preflight
#
# Early-startup checks that catch the most common "this won't work on
# your system" problems before any lesson screen tries to render.
# Silent on success; one-sentence diagnostic + exit 1 on failure.
#
# The checks are intentionally narrow: bash version (already enforced
# at the top of the file), interactive terminal, and writable sandbox.
# Per-command availability (vim, vimtutor, seq, less, ...) is reported
# by --info but is not a hard preflight gate because the lessons that
# need each one handle absence with a fallback or a clear runtime
# message.
# ---------------------------------------------------------------------

preflight() {
    # 1. Interactive terminal. The practice subshell uses
    #    `bash --rcfile /dev/fd/3 -i 3<<RCFILE < /dev/tty`, which only works when
    #    stdin/stdout are a real TTY and /dev/tty is available.
    if [ ! -t 1 ] || [ ! -t 0 ]; then
        printf '%bshelltutor:%b this is an interactive tutor; please run it directly\n' "$EM" "$RST" >&2
        printf 'in a terminal window. stdout or stdin is not a terminal — perhaps the\n' >&2
        printf 'output is being piped, redirected, or the script is running under cron / CI.\n' >&2
        return 1
    fi
    if [ ! -e /dev/tty ]; then
        printf '%bshelltutor:%b /dev/tty is not available; the practice prompts cannot work.\n' "$EM" "$RST" >&2
        printf 'Run the tutor from a normal terminal session, not under a non-interactive service.\n' >&2
        return 1
    fi

    # 2. Writable sandbox.
    if ! mkdir -p "$SANDBOX" 2>/dev/null; then
        printf '%bshelltutor:%b cannot create the sandbox folder at %s%s%s\n' "$EM" "$RST" "$DIR" "$SANDBOX" "$RST" >&2
        printf 'Set SHELLTUTOR_HOME to a writable location, e.g.:\n' >&2
        printf '    %bSHELLTUTOR_HOME=/tmp/shelltutor %s%b\n' "$CMD" "$0" "$RST" >&2
        return 1
    fi
    local writetest="$SANDBOX/.shelltutor_writetest"
    if ! ( : > "$writetest" ) 2>/dev/null; then
        printf '%bshelltutor:%b the sandbox folder exists but is not writable: %s%s%s\n' "$EM" "$RST" "$DIR" "$SANDBOX" "$RST" >&2
        printf 'Set SHELLTUTOR_HOME to a writable location, e.g.:\n' >&2
        printf '    %bSHELLTUTOR_HOME=/tmp/shelltutor %s%b\n' "$CMD" "$0" "$RST" >&2
        return 1
    fi
    rm -f "$writetest" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------
# Diagnostic info (--info)
#
# Prints what the tutor sees about the current environment so a
# beginner can self-diagnose before reading docs. Honest about what's
# OK, what's missing, and what's optional. Exits 0 in all cases —
# this is information, not a gate.
# ---------------------------------------------------------------------

show_info() {
    local ok="${OK}ok${RST}" no="${EM}not ok${RST}" info="${DIM}info${RST}"
    printf '\n%bshelltutor — environment check%b\n\n' "$H1" "$RST"

    # --- bash version
    printf '  %bbash%b         : %s\n' "$SUB" "$RST" "${BASH_VERSION:-unknown}"
    if [ "${BASH_VERSINFO[0]:-0}" -ge 3 ]; then
        printf '                 [%s] requires 3.2+\n' "$ok"
    else
        printf '                 [%s] requires 3.2+; please upgrade bash\n' "$no"
    fi

    # --- login shell (informational)
    printf '  %b$SHELL%b       : %s\n' "$SUB" "$RST" "${SHELL:-(unset)}"
    printf '                 [%s] tutor spawns bash for practice regardless of your login shell\n' "$info"

    # --- sandbox
    printf '  %bSandbox%b      : %s\n' "$SUB" "$RST" "$SANDBOX"
    if [ -d "$SANDBOX" ] && [ -w "$SANDBOX" ]; then
        printf '                 [%s] writable\n' "$ok"
    elif [ -d "$SANDBOX" ]; then
        printf '                 [%s] exists but is not writable — see SHELLTUTOR_HOME override\n' "$no"
    elif [ -w "$(dirname "$SANDBOX")" ] 2>/dev/null; then
        printf '                 [%s] not yet created; will be made on first run\n' "$info"
    else
        printf '                 [%s] parent directory is not writable — see SHELLTUTOR_HOME override\n' "$no"
    fi
    if [ -n "${SHELLTUTOR_HOME:-}" ]; then
        printf '  %b$SHELLTUTOR_HOME%b : %s\n' "$SUB" "$RST" "$SHELLTUTOR_HOME"
    else
        printf '  %b$SHELLTUTOR_HOME%b : %b(unset; default applies)%b\n' "$SUB" "$RST" "$DIM" "$RST"
    fi

    # --- terminal / colour
    printf '  %b$TERM%b        : %s\n' "$SUB" "$RST" "${TERM:-(unset)}"
    if [ -e /dev/tty ]; then
        printf '  %b/dev/tty%b     : available\n' "$SUB" "$RST"
    else
        printf '  %b/dev/tty%b     : %bnot available — practice prompts will fail%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "${NO_COLOR:-}" ]; then
        printf '  %bColour%b       : disabled (NO_COLOR is set)\n' "$SUB" "$RST"
    elif [ -t 1 ]; then
        printf '  %bColour%b       : enabled\n' "$SUB" "$RST"
    else
        printf '  %bColour%b       : disabled (stdout is not a terminal)\n' "$SUB" "$RST"
    fi

    # --- vim / vimtutor (Stage 5 hand-off)
    printf '\n'
    local vim_path vimtutor_path man_path less_path
    vim_path=$(command -v vim 2>/dev/null || true)
    vimtutor_path=$(command -v vimtutor 2>/dev/null || true)
    man_path=$(command -v man 2>/dev/null || true)
    less_path=$(command -v less 2>/dev/null || true)
    if [ -n "$man_path" ]; then
        printf '  %bman%b          : %s\n' "$SUB" "$RST" "$man_path"
    else
        printf '  %bman%b          : %bnot found — Stage 5 lesson 5.1 will skip the man demo%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$less_path" ]; then
        printf '  %bless%b         : %s\n' "$SUB" "$RST" "$less_path"
    else
        printf '  %bless%b         : %bnot found — Stage 3 lesson 3.2 will skip the less demo%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$vim_path" ]; then
        printf '  %bvim%b          : %s\n' "$SUB" "$RST" "$vim_path"
    else
        printf '  %bvim%b          : %bnot found — Stage 5 cannot demo Vim entry/exit until installed%b\n' "$SUB" "$RST" "$EM" "$RST"
    fi
    if [ -n "$vimtutor_path" ]; then
        printf '  %bvimtutor%b     : %s\n' "$SUB" "$RST" "$vimtutor_path"
        printf '                 [%s] Stage 5 finale will hand off to this\n' "$ok"
    else
        printf '  %bvimtutor%b     : %bnot found%b\n' "$SUB" "$RST" "$DIM" "$RST"
        printf '                 [%s] Stage 5 finale will print install hints instead of handing off\n' "$info"
    fi

    printf '\n%bIf anything above is marked "not ok", see README.md "Run" section.%b\n\n' "$DIM" "$RST"
}

# ---------------------------------------------------------------------
# Sandbox + progress
# ---------------------------------------------------------------------

setup_sandbox() {
    mkdir -p "$SANDBOX"
    # Educational fixtures used by Stage 4. Self-heal if removed.
    if [ ! -f "$SANDBOX/poem.txt" ]; then
        cat > "$SANDBOX/poem.txt" <<'POEM'
The terminal is a quiet room.
You speak to it, it answers back.
Words have shapes here, and shapes have weight.
A pipe is a doorway between rooms.
POEM
    fi
    if [ ! -f "$SANDBOX/numbers.txt" ]; then
        seq 1 50 > "$SANDBOX/numbers.txt"
    fi
    touch "$SANDBOX/.shelltutor_history"
}

setup_stage_dir() {
    local n=$1
    mkdir -p "$SANDBOX/stage${n}"
    case "$n" in
        4)  # Stage 4 lessons count lines in poem.txt from inside the
            # stage folder; seed.txt gives the *.txt glob a second match.
            [ -f "$SANDBOX/stage4/poem.txt" ] \
                || cp "$SANDBOX/poem.txt" "$SANDBOX/stage4/poem.txt"
            if [ ! -f "$SANDBOX/stage4/seed.txt" ]; then
                cat > "$SANDBOX/stage4/seed.txt" <<'EOF_SEED'
a small text file
to give the glob something to match
EOF_SEED
            fi
            ;;
        5)  # Lesson 5.3 edits practice.txt; the gate re-seeds it to
            # exactly 'before' at gate entry (stage5_seed_practice).
            [ -f "$SANDBOX/stage5/practice.txt" ] \
                || echo before > "$SANDBOX/stage5/practice.txt"
            ;;
    esac
}

save_progress() {
    # Only advance, never regress. .progress = number of stages passed.
    local cur
    cur=$(read_progress)
    if [ "$1" -gt "$cur" ]; then
        echo "$1" > "$PROGRESS_FILE" 2>/dev/null || true
    fi
}

read_progress() {
    local n=0
    if [ -f "$PROGRESS_FILE" ]; then
        read -r n < "$PROGRESS_FILE" 2>/dev/null || n=0
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        # Defensive clamp. A pre-curriculum-redesign sandbox may carry
        # a .progress value in the old "next lesson index" semantics
        # (0..9). Anything above TOTAL_STAGES is treated as stale and
        # reset to 0 so the learner re-enters at Stage 1 rather than
        # being skipped to the finale.
        if [ "$n" -gt "$TOTAL_STAGES" ]; then n=0; fi
    fi
    echo "$n"
}

# ---------------------------------------------------------------------
# Panel chrome (A3.1-A3.3)
#
# Every tutor screen is a panel between two rules; the practice prompt
# beneath it is the real shell. The runners set PANEL_STAGE (1-5, or empty
# before Stage 1 and on the cleared screen) and PANEL_POS ("1.1", "task",
# or empty) before each screen. Fixed 80 columns: no tput, no COLUMNS.
# Rules are built by a loop: tr on a multibyte glyph and ${s:0:n} both
# count bytes under LC_ALL=C. The title strings are ASCII, so ${#var}
# is a column count; the glyph widths are added as constants.
# ---------------------------------------------------------------------

PANEL_STAGE=''
PANEL_POS=''
PANEL_DONE=''
PANEL_COLS=80

# panel_rule N  -> sets REPLY to N rule glyphs.
panel_rule() {
    local i s=''
    for ((i = 0; i < $1; i++)); do s="$s$G_RULE"; done
    REPLY="$s"
}

panel_title() {
    case "$1" in
        1) REPLY='Where am I?' ;;
        2) REPLY='Paths and the filesystem' ;;
        3) REPLY='Files and operations' ;;
        4) REPLY='Commands, streams, composition' ;;
        5) REPLY='Ready for vimtutor' ;;
        *) REPLY='' ;;
    esac
}

# panel_at STAGE LESSON_FUNCTION: set the globals for the next screen.
panel_at() {
    PANEL_STAGE=$1
    PANEL_POS=''
    case "$2" in
        welcome|orientation) PANEL_STAGE='' ;;
        stage[1-5]_lesson_[1-9]) PANEL_POS="$1.${2##*_}" ;;
    esac
}

panel_header() {
    local prog i title='' head tail dots='' n used
    prog=$(read_progress)
    # Left: "<rule> shelltutor <rule> " is 15 columns.
    used=15
    head="${RULE}${G_RULE}${RST} ${INSTR}shelltutor${RST} ${RULE}${G_RULE}${RST} "
    if [ -n "$PANEL_STAGE" ]; then
        panel_title "$PANEL_STAGE"
        title="$REPLY"
        head="${head}${DIM}Stage ${PANEL_STAGE} ${G_SEP} ${title}${RST} "
        used=$((used + 11 + ${#title}))
    fi
    for ((i = 1; i <= 5; i++)); do
        if [ "$i" = "$PANEL_STAGE" ]; then
            dots="${dots}${INSTR}${G_CUR}${RST}"
        elif [ "$i" -le "$prog" ]; then
            dots="${dots}${OK}${G_DONE}${RST}"
        else
            dots="${dots}${DIM}${G_TODO}${RST}"
        fi
    done
    # Right: " <5 dots>  <pos> <rule>" is 10 columns plus the position.
    tail=" ${dots}  ${INSTR}${PANEL_POS}${RST} ${RULE}${G_RULE}${RST}"
    n=$((PANEL_COLS - used - 10 - ${#PANEL_POS}))
    [ "$n" -ge 1 ] || n=1
    panel_rule "$n"
    printf '%s%s%s%s%s\n' "$head" "$RULE" "$REPLY" "$RST" "$tail"
}

panel_lower_rule() {
    panel_rule "$PANEL_COLS"
    printf '%s%s%s\n' "$RULE" "$REPLY" "$RST"
}

# footer_item VERB GLOSS -> "verb ▸ gloss", verb in KEY, rest DIM.
footer_item() {
    printf '%s%s%s%s %s %s%s' "$KEY" "$1" "$RST" "$DIM" "$G_HINT" "$2" "$RST"
}

# footer_bar MODE: one DIM row, the mode's verb first (A3.3).
footer_bar() {
    case "$1" in
        gate)
            printf '%s   %s   %s' \
                "$(footer_item check 'test your work')" \
                "$(footer_item show 'the task again')" \
                "$(footer_item quit 'save and leave')"
            ;;
        cleared)
            printf '%s   %s   %s' \
                "$(footer_item next "Stage $((${PANEL_DONE:-0} + 1))")" \
                "$(footer_item quit 'stop here, place saved')" \
                "$(footer_item show 'this screen again')"
            ;;
        *)
            printf '%s   %s   %s   %s' \
                "$(footer_item next 'go on')" \
                "$(footer_item show 'this screen again')" \
                "$(footer_item prev 'back')" \
                "$(footer_item quit 'save and leave')"
            ;;
    esac
}

# ---------------------------------------------------------------------
# Practice subshell
#
# Spawns a real interactive bash with a sandboxed HISTFILE and PS1, in
# the requested working directory (defaults to $SANDBOX). The rcfile
# overrides five builtins so that the learner's navigation words exit
# with codes the outer dispatcher interprets:
#   next  -> 0   check -> 96   show -> 97   prev -> 98   quit/exit -> 99
# ---------------------------------------------------------------------

practice() {
    local pd="${1:-$SANDBOX}"
    local mode="${2:-lesson}"
    setup_sandbox
    mkdir -p "$pd"

    # Context-aware footer bar (A3.3). At a lesson the most likely next
    # action is `next`; at a gate it is `check`. Showing the wrong verb at
    # the wrong time trains the learner to type the wrong thing.
    local footer
    footer=$(footer_bar "$mode")

    # Feed the rcfile on fd 3 instead of process substitution. macOS Bash
    # 3.2 can parse <(...) here but does not reliably load it as --rcfile.
    # INPUTRC=/dev/null keeps Readline on its defaults so the practice
    # prompt behaves the same on every host (contract C-007).
    # The practice shell is the same binary as the outer script ($BASH),
    # never whatever `bash` happens to be first on PATH (F-014).
    # BASH_SILENCE_DEPRECATION_WARNING=1 stops Apple's /bin/bash 3.2 from
    # printing a four-row "default shell is now zsh" notice before the
    # first prompt (F-016). Apple's bash checks the variable after the
    # rcfile has run, so the rcfile must not unset it.
    INPUTRC=/dev/null BASH_SILENCE_DEPRECATION_WARNING=1 "$BASH" --rcfile /dev/fd/3 -i 3<<RCFILE < /dev/tty
# shelltutor practice shell — contract C-007 in docs/contracts.md.
# No system or user rcfile is sourced by this file. Distributions that compile Bash
# with a system rcfile still read it before this file; the settings
# below override what matters to the lessons.

# Inherited variables that would change what the lessons show or record.
unset -v CDPATH GLOBIGNORE HISTIGNORE HISTCONTROL HISTTIMEFORMAT TMOUT BASH_ENV
unset -v PROMPT_COMMAND
# Distribution hook that advertises package installs for unknown commands.
unset -f command_not_found_handle

set -o emacs
shopt -s histappend
shopt -u cdspell

cd "$pd"

HISTFILE="$SANDBOX/.shelltutor_history"
HISTSIZE=2000
HISTFILESIZE=4000
history -r 2>/dev/null || true
PROMPT_COMMAND='history -a'

PS1='shelltutor> '
PS2='> '

# Readline: common-Bash completion behaviour, no bell (see lesson 1.2).
bind 'set show-all-if-ambiguous off'
bind 'set show-all-if-unmodified off'
bind 'set completion-ignore-case off'
bind 'set bell-style none'

# Navigation builtins: functions, not aliases, so alias chains can't
# recurse. \`exec >/dev/null 2>&1\` immediately before \`builtin exit\`
# suppresses bash's "exit\n" interactive-logout print (which beginners
# read as a separate command being run); the subshell then exits with
# the navigation code the outer dispatcher interprets.
next()  { exec >/dev/null 2>&1; builtin exit  0; }
check() { exec >/dev/null 2>&1; builtin exit 96; }
prev()  { exec >/dev/null 2>&1; builtin exit 98; }
show()  { exec >/dev/null 2>&1; builtin exit 97; }
quit()  { exec >/dev/null 2>&1; builtin exit 99; }
exit()  { exec >/dev/null 2>&1; builtin exit 99; }

printf '%s\\n' "${footer}"
RCFILE
    local code=$?
    if [ "$code" -eq $RC_QUIT ]; then
        clear 2>/dev/null || true
        echo "Bye. Run 'shelltutor' again to pick up where you left off."
        exit 0
    fi
    return "$code"
}

# ---------------------------------------------------------------------
# Lesson screen helper
# ---------------------------------------------------------------------

show_screen() {
    clear 2>/dev/null || printf '\n'
    panel_header
    printf '\n'
    cat
    panel_lower_rule
}

# Optional directory argument: the practice prompt starts there. Stages 1
